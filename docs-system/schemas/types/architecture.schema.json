{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludots.dev/schemas/types/architecture.schema.json",
  "title": "架构文档（设计 / 描述合一）",
  "description": "一套规格覆盖两个阶段：phase=planned 为开发期『架构设计』（意图/方案）；phase=as-built 为开发完成后『架构描述』（现状/可验证）。as-built 必须给 verification 证据。",
  "type": "object",
  "allOf": [{ "$ref": "../document.base.schema.json" }],
  "properties": {
    "type": { "const": "architecture" },
    "phase": { "type": "string", "enum": ["planned", "as-built"], "description": "planned=架构设计(开发期)；as-built=架构描述(完成后)。" },
    "purpose": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "context": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 80 },
          "responsibility": { "type": "string", "maxLength": 280 },
          "code": { "type": "string", "description": "真实源码路径，CI 校验存在。" }
        },
        "required": ["name", "responsibility"],
        "additionalProperties": false
      }
    },
    "dataFlow": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "boundaries": { "type": "array", "items": { "type": "string", "maxLength": 280 }, "description": "明确不负责什么。" },
    "risks": { "type": "array", "items": { "type": "string", "maxLength": 280 } },
    "verification": {
      "type": "array",
      "description": "as-built 必填：每条结论对应的测试/基准/审计证据路径。",
      "items": {
        "type": "object",
        "properties": {
          "aspect": { "type": "string", "maxLength": 200 },
          "evidence": { "type": "string", "description": "测试/基准/产物路径，CI 校验存在。" }
        },
        "required": ["aspect", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["phase", "purpose", "components"],
  "if": { "properties": { "phase": { "const": "as-built" } } },
  "then": { "required": ["verification"] },
  "unevaluatedProperties": false
}
