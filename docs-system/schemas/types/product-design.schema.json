{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludots.dev/schemas/types/product-design.schema.json",
  "title": "产品设计文档",
  "description": "承接 PRD，定义『要什么』如何呈现为用户体验：用户流、状态/界面、交互与边缘情况。用 relatedDocs(depends-on) 指回 PRD。",
  "type": "object",
  "allOf": [{ "$ref": "../document.base.schema.json" }],
  "properties": {
    "type": { "const": "product-design" },
    "overview": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "userFlows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 280 } }
        },
        "required": ["name", "steps"],
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 400 },
          "asset": { "$ref": "../blocks.schema.json#/$defs/diagramBlock" }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    "interactions": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "edgeCases": { "type": "array", "items": { "type": "string", "maxLength": 280 } },
    "dependencies": { "type": "array", "items": { "type": "string", "maxLength": 280 } }
  },
  "required": ["overview", "userFlows"],
  "unevaluatedProperties": false
}
