{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludots.dev/schemas/types/api-reference.schema.json",
  "title": "API / 扩展点参考",
  "description": "代码 API 与扩展点参考。成员绑定真实符号与源码路径。",
  "type": "object",
  "allOf": [{ "$ref": "../document.base.schema.json" }],
  "properties": {
    "type": { "const": "api-reference" },
    "apiName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string", "maxLength": 160 },
          "memberKind": { "type": "string", "enum": ["type", "method", "property", "event", "extension-point", "registry", "pipeline"] },
          "signature": { "type": "string", "maxLength": 280 },
          "description": { "type": "string", "maxLength": 400 },
          "code": { "type": "string", "description": "真实源码路径，CI 校验存在。" }
        },
        "required": ["symbol", "memberKind", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["apiName", "members"],
  "unevaluatedProperties": false
}
