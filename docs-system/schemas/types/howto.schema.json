{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludots.dev/schemas/types/howto.schema.json",
  "title": "操作指南 How-to",
  "description": "任务导向，『如何做 X』的最短路径步骤。",
  "type": "object",
  "allOf": [{ "$ref": "../document.base.schema.json" }],
  "properties": {
    "type": { "const": "howto" },
    "task": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "prerequisites": { "type": "array", "items": { "type": "string", "maxLength": 280 } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "instruction": { "$ref": "../blocks.schema.json#/$defs/blocks" }
        },
        "required": ["title", "instruction"],
        "additionalProperties": false
      }
    }
  },
  "required": ["task", "steps"],
  "unevaluatedProperties": false
}
