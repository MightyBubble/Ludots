{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludots.dev/schemas/types/uat.schema.json",
  "title": "用户验收测试 (UAT) 设计",
  "description": "验收测试设计：目标、前置条件、given/when/then 场景与通过标准。场景可挂接验收证据路径。",
  "type": "object",
  "allOf": [{ "$ref": "../document.base.schema.json" }],
  "properties": {
    "type": { "const": "uat" },
    "objective": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "scope": { "type": "array", "items": { "type": "string", "maxLength": 280 } },
    "preconditions": { "type": "array", "items": { "type": "string", "maxLength": 280 } },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "maxLength": 40 },
          "given": { "type": "string", "maxLength": 400 },
          "when": { "type": "string", "maxLength": 400 },
          "then": { "type": "string", "maxLength": 400 },
          "evidence": { "type": "string", "description": "验收产物/测试路径，可选，CI 校验存在。" }
        },
        "required": ["id", "given", "when", "then"],
        "additionalProperties": false
      }
    },
    "passCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 280 } },
    "outOfScope": { "type": "array", "items": { "type": "string", "maxLength": 280 } }
  },
  "required": ["objective", "scenarios", "passCriteria"],
  "unevaluatedProperties": false
}
