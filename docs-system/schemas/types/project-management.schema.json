{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludots.dev/schemas/types/project-management.schema.json",
  "title": "项管文档",
  "description": "里程碑、工作流拆分、风险与依赖的项目管理视图。里程碑字段化、有退出标准与状态。",
  "type": "object",
  "allOf": [{ "$ref": "../document.base.schema.json" }],
  "properties": {
    "type": { "const": "project-management" },
    "objective": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "due": { "type": "string", "format": "date" },
          "status": { "type": "string", "enum": ["planned", "in-progress", "done", "blocked", "dropped"] },
          "exitCriteria": { "type": "array", "items": { "type": "string", "maxLength": 280 } }
        },
        "required": ["name", "status"],
        "additionalProperties": false
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "owner": { "type": "string", "maxLength": 80 },
          "status": { "type": "string", "enum": ["planned", "in-progress", "done", "blocked", "dropped"] }
        },
        "required": ["name", "owner", "status"],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": { "type": "string", "maxLength": 280 },
          "mitigation": { "type": "string", "maxLength": 280 },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        },
        "required": ["risk", "severity"],
        "additionalProperties": false
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string", "maxLength": 280 } },
    "timeline": { "$ref": "../blocks.schema.json#/$defs/diagramBlock" }
  },
  "required": ["milestones"],
  "unevaluatedProperties": false
}
