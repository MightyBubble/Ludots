{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludots.dev/schemas/types/technical-design.schema.json",
  "title": "技术设计文档 (TDD)",
  "description": "开发期 feature 级详设：选定的技术方案、数据模型、接口改动、测试计划与被否方案。承接 PRD/架构设计，落到具体代码。",
  "type": "object",
  "allOf": [{ "$ref": "../document.base.schema.json" }],
  "properties": {
    "type": { "const": "technical-design" },
    "problem": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "approach": { "$ref": "../blocks.schema.json#/$defs/blocks" },
    "dataModel": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 400 },
          "code": { "type": "string", "description": "真实源码路径，CI 校验存在。" }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    "apiChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string", "maxLength": 160 },
          "change": { "type": "string", "enum": ["add", "modify", "remove"] },
          "note": { "type": "string", "maxLength": 280 }
        },
        "required": ["symbol", "change"],
        "additionalProperties": false
      }
    },
    "testPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case": { "type": "string", "maxLength": 280 },
          "expectation": { "type": "string", "maxLength": 280 },
          "testCode": { "type": "string", "description": "测试路径，可选，CI 校验存在。" }
        },
        "required": ["case", "expectation"],
        "additionalProperties": false
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "option": { "type": "string", "maxLength": 120 }, "whyNot": { "type": "string", "maxLength": 400 } },
        "required": ["option", "whyNot"],
        "additionalProperties": false
      }
    },
    "rolloutSteps": { "type": "array", "items": { "type": "string", "maxLength": 280 } },
    "risks": { "type": "array", "items": { "type": "string", "maxLength": 280 } }
  },
  "required": ["problem", "approach", "testPlan"],
  "unevaluatedProperties": false
}
