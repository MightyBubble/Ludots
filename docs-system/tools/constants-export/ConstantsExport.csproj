<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LudotsConstantsExport</AssemblyName>
    <RootNamespace>Ludots.DocsTools.ConstantsExport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reflects over the real engine constants. Adjust the relative path if the layout changes. -->
    <ProjectReference Include="..\..\..\src\Core\Ludots.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="allowlist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
