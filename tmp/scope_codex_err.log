        Entity Entity,
        string ActivityId,
        string DisplayName,
        string Summary,
        ActivityInstanceState State,
        ActivityDispatchPolicy DispatchPolicy,
        int InstanceId,
        string SelectedOptionId,
        Entity ScopeHost);

