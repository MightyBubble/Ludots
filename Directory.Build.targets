<Project>
  <!--
    global.json 用 rollForward=latestFeature，CI 装的是浮动的 9.0 SDK。
    新 SDK 会把 net6/net7/net8 的 KnownFrameworkReference 补丁号改成当月 servicing 版本，
    再按这个精确版本向 NuGet 要 Microsoft.NETCore.App.Ref、Microsoft.AspNetCore.App.Ref、
    Microsoft.WindowsDesktop.App.Ref。根 nuget.config 清空了公共源，离线源里只有
    6.0.36 / 7.0.20 / 8.0.31。这里把下位目标框架钉回这三档，还原才不会被下一次 SDK 补丁打断。
    net9 的引用包随 SDK 自带，不在这条钉死范围内。
    仓库里另有 Directory.Build.targets 的目录必须再导入本文件：MSBuild 只取离项目最近的那一份。
  -->
  <Target Name="PinOfflineDownlevelTargetingPacks" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <KnownFrameworkReference Update="Microsoft.NETCore.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net8.0'">
        <TargetingPackVersion>8.0.31</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>8.0.31</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
      <KnownFrameworkReference Update="Microsoft.AspNetCore.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net8.0'">
        <TargetingPackVersion>8.0.31</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>8.0.31</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
      <KnownFrameworkReference Update="Microsoft.WindowsDesktop.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net8.0'">
        <TargetingPackVersion>8.0.31</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>8.0.31</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>

      <KnownFrameworkReference Update="Microsoft.NETCore.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net7.0'">
        <TargetingPackVersion>7.0.20</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>7.0.20</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
      <KnownFrameworkReference Update="Microsoft.AspNetCore.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net7.0'">
        <TargetingPackVersion>7.0.20</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>7.0.20</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
      <KnownFrameworkReference Update="Microsoft.WindowsDesktop.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net7.0'">
        <TargetingPackVersion>7.0.20</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>7.0.20</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>

      <KnownFrameworkReference Update="Microsoft.NETCore.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net6.0'">
        <TargetingPackVersion>6.0.36</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>6.0.36</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
      <KnownFrameworkReference Update="Microsoft.AspNetCore.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net6.0'">
        <TargetingPackVersion>6.0.36</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>6.0.36</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
      <KnownFrameworkReference Update="Microsoft.WindowsDesktop.App" Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net6.0'">
        <TargetingPackVersion>6.0.36</TargetingPackVersion>
        <LatestRuntimeFrameworkVersion>6.0.36</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
    </ItemGroup>
  </Target>
</Project>
