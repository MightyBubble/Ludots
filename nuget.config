<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    离线包源只在这一处声明：目录 external/nuget/，源名 LudotsOffline。
    <clear/> 覆盖用户级和子目录配置，全部工程（含 Cef / Ultralight）都走这份源，不另开公共源。
    增删 PackageReference 后把 nupkg 放进 external/nuget/（见 gitbook/reference/zero-env-setup.md）。
    工程目标框架是 net9.0；引用包用离线源里的 net9 App.Ref，不再保留 net6/net7/net8 目标。
  -->
  <packageSources>
    <clear />
    <add key="LudotsOffline" value="external/nuget" />
  </packageSources>
</configuration>
