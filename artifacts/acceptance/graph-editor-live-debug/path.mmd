flowchart LR
    A[health pumpCount 增长] --> B[entities.query: raider=0]
    B --> C[PointerPos + CommandSourceAcquire]
    C --> D[RegionEntered raid_circle]
    D --> E[SpawnTemplate wave1 x420 y=-140/0/140]
    E --> F[截图 wave1-spawned]
    F --> G[右键处决 team2]
    G --> H[EntityAliveCountChanged cross_below 0]
    H --> I[SpawnTemplate elite x760 y=-110/110]
    I --> J[右键处决 team3]
    J --> K[kill_count=5]
    K --> L[SpawnTemplate boss at boss_camp 1000,0]
    L --> M[截图 boss-spawned]
    M --> N[右键处决 Boss]
    N --> O[Yield 挂起两拍]
    O --> P[stage=5 + VICTORY]
    P --> Q[截图 victory-stage5]
