<Project>
  <Target Name="ExcludeUnrelatedDeferredTriggerCompilationFailure" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'GasTests'">
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Compile.Filename)' == 'DeferredTriggerTests'" />
    </ItemGroup>
  </Target>
</Project>
