{
  "name": "hex-grid-coordinates",
  "title": "Hex Grid Coordinate System",
  "subtitle": "HexCoordinates -> Axial -> Cube -> Pixel 4-Level Conversion",
  "canvas": { "width": 1980, "height": 1480 },

  "groups": [
    { "id": "g_coord", "title": "Coordinate Systems",
      "x": 40, "y": 120, "w": 560, "h": 700, "border_style": "dashed", "title_anchor": "top-left" },
    { "id": "g_formula", "title": "Conversion Formulas",
      "x": 640, "y": 120, "w": 560, "h": 700, "border_style": "dashed", "title_anchor": "top-left" },
    { "id": "g_util", "title": "Hex Utilities",
      "x": 1240, "y": 120, "w": 700, "h": 700, "border_style": "dashed", "title_anchor": "top-left" },
    { "id": "g_ring", "title": "Ring(radius)",
      "x": 40, "y": 860, "w": 560, "h": 480, "border_style": "dashed", "title_anchor": "top-left" },
    { "id": "g_disk", "title": "Disk(radius)",
      "x": 680, "y": 860, "w": 560, "h": 480, "border_style": "dashed", "title_anchor": "top-left" },
    { "id": "g_spiral", "title": "Spiral(maxRadius)",
      "x": 1320, "y": 860, "w": 560, "h": 480, "border_style": "dashed", "title_anchor": "top-left" }
  ],

  "nodes": [
    { "id": "hex_00", "title": "0,0", "tint": "steel", "border_w": 1.6, "x": 265, "y": 385, "w": 110, "h": 70 },
    { "id": "hex_10", "title": "1,0", "x": 445, "y": 385, "w": 110, "h": 70 },
    { "id": "hex_m10", "title": "-1,0", "x": 85, "y": 385, "w": 110, "h": 70 },
    { "id": "hex_01", "title": "0,1", "x": 355, "y": 235, "w": 110, "h": 70 },
    { "id": "hex_m11", "title": "-1,1", "x": 175, "y": 235, "w": 110, "h": 70 },
    { "id": "hex_0m1", "title": "0,-1", "x": 175, "y": 535, "w": 110, "h": 70 },
    { "id": "hex_1m1", "title": "1,-1", "x": 355, "y": 535, "w": 110, "h": 70 },

    { "id": "formulas", "title": "Conversion Formulas", "tint": "slate", "valign": "top",
      "x": 690, "y": 190, "w": 460, "h": 560,
      "items": [
        "Axial -> Cube",
        "x = q    y = -q - r    z = r",
        "Cube -> Axial",
        "q = x    r = z",
        "Axial -> Pixel",
        "px = size * (q + r/2)    py = size * r * 3/2",
        "Pixel -> Axial",
        "q = (px * 2/3) / size    r = (-px/3 + py/2) / size",
        "Cube -> Pixel",
        "px = size * (x + z/2)    py = size * z * 3/2"
      ] },

    { "id": "neighbors", "title": "6 Neighbors (Axial)", "tint": "slate", "valign": "top",
      "x": 1290, "y": 190, "w": 420, "h": 280,
      "items": [
        "(+1, 0)  East",
        "(+1, -1)  North-East",
        "(0, -1)  North-West",
        "(-1, 0)  West",
        "(-1, +1)  South-West",
        "(0, +1)  South-East"
      ] },
    { "id": "distance", "title": "Distance Formulas", "tint": "slate",
      "x": 1290, "y": 520, "w": 560, "h": 120,
      "items": [
        "Cube: dist = (|dx| + |dy| + |dz|) / 2",
        "Axial: dist = (|dq| + |dr| + |dq+dr|) / 2"
      ] },

