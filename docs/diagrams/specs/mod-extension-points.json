    { "from": "imodctx", "to": "ep2", "route": "elbow", "from_side": "right", "to_side": "left", "stub": 42, "arrow": false, "color": "#b6bdc8", "width": 1.0 },
    { "from": "imodctx", "to": "ep3", "route": "elbow", "from_side": "right", "to_side": "left", "stub": 60, "arrow": false, "color": "#b6bdc8", "width": 1.0 },
    { "from": "imodctx", "to": "ep4", "route": "elbow", "from_side": "right", "to_side": "left", "stub": 78, "arrow": false, "color": "#b6bdc8", "width": 1.0 },
    { "from": "imodctx", "to": "ep5", "route": "elbow", "from_side": "right", "to_side": "left", "stub": 96, "arrow": false, "color": "#b6bdc8", "width": 1.0 },
    { "from": "imodctx", "to": "ep6", "route": "elbow", "from_side": "right", "to_side": "left", "stub": 114, "arrow": false, "color": "#b6bdc8", "width": 1.0 }
