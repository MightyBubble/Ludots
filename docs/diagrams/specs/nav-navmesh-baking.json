{
  "name": "nav-navmesh-baking",
  "title": "NavMesh Baking Pipeline",
  "subtitle": "From Terrain Geometry to usable Navigation Mesh",
  "canvas": { "width": 1700, "height": 1060 },

  "nodes": [
    { "id": "root", "title": "Geometry Input", "tint": "steel", "border_w": 1.6,
      "x": 700, "y": 140, "w": 300, "h": 80 },

