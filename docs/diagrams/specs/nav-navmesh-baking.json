    { "id": "r1c", "title": "WalkMaskBuilder", "tint": "steel", "x": 800, "y": 300, "w": 340, "h": 90, "items": ["(Walk Mask)"] },
    { "id": "r1d", "title": "NavBakeContext", "tint": "steel", "x": 1170, "y": 300, "w": 340, "h": 90, "items": ["(Bake Context)"] },

    { "id": "r2a", "title": "ContourExtractor", "tint": "steel", "x": 60, "y": 470, "w": 340, "h": 90, "items": ["(Contour Extract)"] },
    { "id": "r2b", "title": "CdtTriangulator", "tint": "steel", "x": 430, "y": 470, "w": 340, "h": 90, "items": ["(CDT Triangulate)"] },
    { "id": "r2c", "title": "PolygonProcessor", "tint": "steel", "x": 800, "y": 470, "w": 340, "h": 90, "items": ["(Polygon Process)"] },
    { "id": "r2d", "title": "GridMeshBuilder", "tint": "steel", "x": 1170, "y": 470, "w": 340, "h": 90, "items": ["(Grid Build)"] },

