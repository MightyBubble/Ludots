    { "id": "queue", "title": "RuntimeIncremental", "tint": "stone", "x": 60, "y": 830, "w": 340, "h": 90, "items": ["NavMeshRebuildQueue"] },
    { "id": "store", "title": "NavTileStore / Runtime Query", "tint": "clay", "border_w": 1.6, "x": 680, "y": 830, "w": 340, "h": 90 }
