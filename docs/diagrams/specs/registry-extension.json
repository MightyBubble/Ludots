    { "from": "m22", "to": "m23", "route": "straight" },
    { "from": "m23", "to": "m24", "route": "straight" },
    { "from": "m24", "to": "m25", "route": "straight" },
    { "from": "m25", "to": "m31", "route": "straight", "color": "#b6bdc8" },
    { "from": "m31", "to": "m32", "route": "straight" },
    { "from": "m32", "to": "m41", "route": "straight", "color": "#b6bdc8" },
    { "from": "m41", "to": "m42", "route": "straight" }
  ]
