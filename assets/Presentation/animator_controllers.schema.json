{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ludots://presentation/animator_controllers.schema.json",
  "title": "Ludots animator controllers",
  "type": "array",
  "description": "Mod-side Presentation/animator_controllers.json. Explicit state machines: every state, transition and defaultStateIndex field is explicit-required with no silent defaults. parameterIndex is a semantic string ('none' allowed, numeric ids rejected at load time). Cross-field rules (state index ranges, condition-specific parameterIndex requirements, consumeTrigger only with Trigger, exitTime in [0,1] only with hasExitTime, orderedInterruption requiring a non-None interruptSource) are enforced at load time. Field sets mirror AnimatorControllerConfigLoader. Authoring guide: gitbook/reference/mod-editor-prd/config/pres-03-animation.md.",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "states", "transitions", "defaultStateIndex"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "states": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/state" }
      },
      "transitions": {
        "type": "array",
        "items": { "$ref": "#/$defs/transition" }
      },
      "defaultStateIndex": { "type": "integer", "minimum": 0 }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packedStateIndex", "durationSeconds", "playbackSpeed", "loop"],
      "properties": {
        "packedStateIndex": { "type": "integer", "minimum": 0 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "playbackSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromStateIndex", "toStateIndex", "conditionKind", "parameterIndex",
        "threshold", "durationSeconds", "durationMode", "consumeTrigger",
        "hasExitTime", "exitTime", "interruptSource", "orderedInterruption"
      ],
      "properties": {
        "fromStateIndex": { "type": "integer", "minimum": 0 },
        "toStateIndex": { "type": "integer", "minimum": 0 },
        "conditionKind": {
          "enum": ["None", "Trigger", "BoolTrue", "BoolFalse", "FloatGreaterOrEqual", "FloatLessOrEqual", "AutoOnNormalizedTime"]
        },
        "parameterIndex": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "durationMode": { "enum": ["Seconds", "NormalizedSourceState"] },
        "consumeTrigger": { "type": "boolean" },
        "hasExitTime": { "type": "boolean" },
        "exitTime": { "type": "number", "minimum": 0, "maximum": 1 },
        "interruptSource": { "enum": ["None", "CurrentState", "NextState", "CurrentThenNext", "NextThenCurrent"] },
        "orderedInterruption": { "type": "boolean" }
      }
    }
  }
}
