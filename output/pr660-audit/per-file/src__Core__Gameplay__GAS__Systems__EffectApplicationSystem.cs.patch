+            {
+                ValidateListenerCapacityForEntity(context.Target, targetAdds + sourceAdds);
+                return;
+            }
+
+            ValidateListenerCapacityForEntity(context.Target, targetAdds);
+            ValidateListenerCapacityForEntity(context.Source, sourceAdds);
