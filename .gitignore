# =============================================
# Ludots Project .gitignore
# =============================================

# ----- .NET / C# 构建产物 -----
**/bin/
**/obj/
# Ludots Pi frontend CLI is source, not a .NET build directory
!src/Tools/Ludots.Pi/web/bin/
!src/Tools/Ludots.Pi/web/bin/**
**/publish/
*.nupkg
*.snupkg
*.pdb
# NuGet Packages
packages/
**/TestResults/
**/*.trx
**/*.coverage
**/*.coveragexml

# ----- Mod 构建产物（避免提交编译副作用） -----
src/Mods/**/ref/
assets/**/ref/

# ----- IDE / 编辑器 -----
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ----- Cursor IDE -----
# 保留 .cursor/rules/ 等项目规则，排除其余 IDE 状态
.cursor/*
!.cursor/rules/

# ----- Node.js -----
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/dist/
**/.next/
**/.vite/
**/.cache/
**/coverage/

# ----- 通用本地配置 -----
.env
.env.*
!.env.example

# ----- Rust (external/SuperECS/Samples/Avian) -----
target/

# ----- 临时文件与缓存 -----
**/__pycache__/
*.py[cod]
.tmp/
.trae/
raylib_temp/

# ----- 构建日志与调试输出 -----
build_*.log
build_*.txt
build_error*.log
build_error*.txt
build_full.log
build_output.txt
build.log
debug_error*.txt
debug_output*.txt

# ----- User Requested Ignores -----
external/
# docs/  <-- Un-ignore docs to keep archived documentation
# Ignore build/runtime evidence by default, but keep GraphNodeOp player
# gallery videos (Git LFS) and gallery posters for GitHub Pages.
artifacts/*
!artifacts/gas-composition-gate.md
!artifacts/gas-composition-gate-*.md
!artifacts/evidence/
artifacts/evidence/*
!artifacts/evidence/capability_standard_graph_op_*/
artifacts/evidence/capability_standard_graph_op_*/*
!artifacts/evidence/capability_standard_graph_op_*/play.mp4
!artifacts/evidence/capability_standard_graph_op_*/poster.png
# acceptance evidence already force-tracked historically; keep pattern open
!artifacts/acceptance/
!artifacts/acceptance/**
BrowserRuntime/
_temp_export/
.codex_out/

# ----- Build Logs & Artifacts -----
msbuild.log
out.log
out.host.*.log
*.zip
*.dll

# ----- Native 二进制白名单（预编译平台依赖，需跟踪） -----
!src/Platforms/Desktop/raylib.dll
!src/Platforms/Desktop/libraylib.so
!src/Libraries/SkiaSharp/runtimes/**/native/*

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# 站点组装产物
_site/
