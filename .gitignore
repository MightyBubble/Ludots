# =============================================
# Ludots Project .gitignore
# =============================================

# ----- .NET / C# 构建产物 -----
**/bin/
**/obj/
**/publish/
*.nupkg
*.snupkg
*.pdb
# NuGet Packages
packages/
**/TestResults/
**/*.trx
**/*.coverage
**/*.coveragexml

# ----- Mod 构建产物（避免提交编译副作用） -----
src/Mods/**/ref/
assets/**/ref/

# ----- IDE / 编辑器 -----
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ----- Cursor IDE -----
# 保留 .cursor/rules/ 等项目规则，排除其余 IDE 状态
.cursor/*
!.cursor/rules/

# ----- Node.js -----
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/dist/
**/.next/
**/.vite/
**/.cache/
**/coverage/

# ----- 通用本地配置 -----
.env
.env.*
!.env.example

# ----- Rust (external/SuperECS/Samples/Avian) -----
target/

# ----- 临时文件与缓存 -----
**/__pycache__/
*.py[cod]
.tmp/
.trae/
raylib_temp/

# ----- 构建日志与调试输出 -----
build_*.log
build_*.txt
build_error*.log
build_error*.txt
build_full.log
build_output.txt
build.log
debug_error*.txt
debug_output*.txt

# ----- User Requested Ignores -----
# external/ 下的第三方内容默认忽略，但离线依赖层必须入库（0 网络契约）：
#   external/nuget/ —— 离线 NuGet 源（规范闭包 nupkg）
#   external/ref/  —— net9.0 框架引用程序集（无 SDK mod 编译器消费）
external/*
!external/nuget/
!external/nuget/**
!external/ref/
!external/ref/**
# docs/  <-- Un-ignore docs to keep archived documentation
# Ignore build/runtime evidence by default, but keep gallery player
# videos (Git LFS) and gallery posters for GitHub Pages:
# GraphNodeOp node galleries and Raylib engine gallery scenes.
artifacts/*
!artifacts/gas-composition-gate.md
!artifacts/gas-composition-gate-*.md
!artifacts/showcases/
artifacts/showcases/*
!artifacts/showcases/graph-fsm-bt-refactor-design.md
!artifacts/showcases/enum-driven-fsm-showcase-design.md
!artifacts/showcases/capability-standard-*/
!artifacts/evidence/
artifacts/evidence/*
!artifacts/evidence/capability_standard_graph_op_*/
artifacts/evidence/capability_standard_graph_op_*/*
!artifacts/evidence/capability_standard_graph_op_*/play.mp4
!artifacts/evidence/capability_standard_graph_op_*/poster.png
!artifacts/evidence/engine_raylib_*/
artifacts/evidence/engine_raylib_*/*
!artifacts/evidence/engine_raylib_*/play.mp4
!artifacts/evidence/engine_raylib_*/poster.png
# Raylib asset acceptance tool recordings (tutorial media on the Agent Bridge tab).
!artifacts/evidence/raylib_asset_acceptance_*/
artifacts/evidence/raylib_asset_acceptance_*/*
!artifacts/evidence/raylib_asset_acceptance_*/play.mp4
!artifacts/evidence/raylib_asset_acceptance_*/poster.png
!artifacts/evidence/raylib_asset_acceptance_*/blocker_rock.png
!artifacts/evidence/raylib_asset_acceptance_*/error-panel.png
!artifacts/evidence/raylib_asset_acceptance_*/textured-cube.png
!artifacts/evidence/raylib_asset_acceptance_*/manifest.json
# acceptance evidence already force-tracked historically; keep pattern open
!artifacts/acceptance/
!artifacts/acceptance/**
BrowserRuntime/
_temp_export/
.codex_out/

# ----- Build Logs & Artifacts -----
msbuild.log
out.log
out.host.*.log
*.zip
*.dll

# ----- Native 二进制白名单（预编译平台依赖，需跟踪） -----
!src/Platforms/Desktop/raylib.dll
!src/Platforms/Desktop/libraylib.so
!src/Libraries/SkiaSharp/runtimes/**/native/*
# external/ref/ 的框架引用程序集（无 SDK mod 编译器消费，0 网络契约）
!external/ref/**/*.dll

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# 站点组装产物
_site/

# 本地工作环境产物——不得入库（PR 审计 #1037 教训）
.npmcache/
.tmp-logs/
.dsh-*
.worktrees/
dist/
