<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ported sango simulation sources predate nullable annotations; annotations-only
         keeps occasional `T?` syntax legal without flooding the port with nullable analysis warnings. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Core\Ludots.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="External\TKNewtonsoft\TKNewtonsoft.csproj" />
    <ProjectReference Include="..\..\..\src\Libraries\Ludots.AgentBridge\Ludots.AgentBridge.csproj" />
  </ItemGroup>

  <!-- Vendored TKNewtonsoft lives in its own project; keep it out of this project's automatic glob. -->
  <ItemGroup>
    <Compile Remove="External\**\*.cs" />
  </ItemGroup>
</Project>
