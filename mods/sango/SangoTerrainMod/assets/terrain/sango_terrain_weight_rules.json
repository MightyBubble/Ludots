      "rockBoostPower": 1.35,
      "rockBoostRise": 0.18
    },
    "noise": {
      "frequency": 0.012,
      "amplitude": 0.22,
      "octaves": 3,
      "seed": 20260903
    },
    "cellSmoothing": {
      "note": "terrainType is per 2000cm cell; control map is 2048^2 (8px/cell). Type field is bilinearly upsampled with a 1-cell blur so material edges stay soft, then noise breaks the lattice.",
      "blurCells": 1.0
    }
  },
