  "heightSlopeModulation": {
    "note": "Multiplicative modulation blended 65% type-base + 35% modulation before renormalize; keeps 23-type identity while restoring continuous-height/slope realism (mountain rock, shoreline sand).",
    "typeBaseMix": 0.65,
    "bands": {
      "sand": {
        "riseStart": -0.02,
        "riseEnd": 0.005,
        "fallStart": 0.035,
        "fallEnd": 0.075
      },
      "grass": {
        "riseStart": 0.005,
        "riseEnd": 0.03,
        "fallStart": 0.28,
        "fallEnd": 0.45
      },
      "dirt": {
        "riseStart": 0.1,
        "riseEnd": 0.22,
        "fallStart": 0.45,
        "fallEnd": 0.62
