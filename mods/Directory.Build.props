<Project>
  <!--
    开发即发布：Mod 统一输出到 bin/net9.0/，无 Debug/Release 区分。
    注意：这里的 TFM 字面量必须与各 mod csproj 的 <TargetFramework> 保持同步
    （props 阶段取不到 $(TargetFramework)，无法动态拼接）。
  -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)net9.0\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
