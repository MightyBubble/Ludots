[
  {
    "id": "cnc.graph.armyComposition",
    "kind": "Query",
    "entry": "allMapEntities",
    "nodes": [
      {
        "id": "allMapEntities",
        "op": "QueryAllMapEntities",
        "next": "filterTeam"
      },
      {
        "id": "filterTeam",
