      },
      {
        "from": "border_panel",
        "fromPort": "next",
        "to": "border_show"
      },
      {
        "from": "border_show",
        "fromPort": "next",
        "to": "load_ok"
      },
      {
        "from": "load_ok",
        "fromPort": "next",
        "to": "load_done"
      }
    ],
    "valueEdges": [
      {
        "from": "load_one",
