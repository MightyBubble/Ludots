[
  {
    "id": "east_asia_borders_bootstrap",
    "rules": [
      {
        "event": { "kind": "EntitySpawned", "key": "east_asia_army" },
        "condition": { "inline": "SourceHasVisualTransform" },
        "command": {
          "kind": "CreatePresenter",
          "definitionId": "east_asia_army",
          "scopeSource": "EventPayloadA"
        }
      },
      {
        "event": { "kind": "EntityDestroyed", "key": "east_asia_army" },
        "command": {
          "kind": "DestroyPresenterScope",
          "scopeSource": "EventPayloadA"
        }
      },
      {
        "event": { "kind": "EntitySpawned", "key": "east_asia_ship" },
        "condition": { "inline": "SourceHasVisualTransform" },
        "command": {
          "kind": "CreatePresenter",
          "definitionId": "east_asia_ship",
          "scopeSource": "EventPayloadA"
        }
      },
      {
        "event": { "kind": "EntityDestroyed", "key": "east_asia_ship" },
        "command": {
          "kind": "DestroyPresenterScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ]
  },
  {
    "id": "east_asia_army",
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "mass_navigation.command.marker",
          "materialId": "default_surface",
          "renderPath": "InstancedStaticMesh",
          "mobility": "Movable",
          "localScale": [120, 20, 120]
        },
        "style": { "color": [1.0, 0.92, 0.12, 1] }
      },
      {
        "slot": "grounding",
        "kind": "Grounding",
        "activeByDefault": true,
        "grounding": {
          "mode": "SnapToGround",
          "offset": 40,
          "updatePolicy": "EveryFrame"
        }
      }
    ]
  },
  {
    "id": "east_asia_ship",
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "mass_navigation.command.marker",
          "materialId": "default_surface",
          "renderPath": "InstancedStaticMesh",
          "mobility": "Movable",
          "localScale": [220, 30, 120]
        },
        "style": { "color": [0.15, 0.75, 1.0, 1] }
      },
      {
        "slot": "grounding",
        "kind": "Grounding",
        "activeByDefault": true,
        "grounding": {
          "mode": "SnapToGround",
          "offset": 40,
          "updatePolicy": "EveryFrame"
        }
      }
    ]
  }
]
