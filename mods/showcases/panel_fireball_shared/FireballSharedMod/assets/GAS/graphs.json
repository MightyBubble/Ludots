        "to": "create"
      },
      {
        "from": "create",
        "fromPort": "next",
        "to": "show"
      },
      {
        "from": "show",
        "fromPort": "next",
        "to": "ok"
      },
      {
        "from": "ok",
        "fromPort": "next",
        "to": "halt"
      }
    ],
    "valueEdges": [
      {
        "from": "scope",
        "fromPort": "value",
        "to": "create",
        "toPort": "source"
      },
      {
        "from": "ok",
        "fromPort": "value",
        "to": "halt",
        "toPort": "value"
      }
    ]
