  {
    "id": "Graph.Ucp.Cast",
    "kind": "TriggerGraph",
    "entries": [
      {
        "label": "on_panel_cast",
        "event": "panel.Ui.CastFire",
        "start": "caster",
        "refire": "restart"
      }
    ],
    "nodes": [
      {
        "id": "caster",
        "op": "LoadCaster"
      },
      {
        "id": "slot",
        "op": "LoadEntryPayloadInt",
        "payloadKey": "Ucp.Slot"
      },
      {
        "id": "enemies",
        "op": "QueryFromCollection",
        "collectionKey": "ucp.enemies"
      },
      {
        "id": "enemyTeam",
        "op": "QueryFilterTeam",
        "teamId": 2
      },
      {
        "id": "idx0",
        "op": "ConstInt",
        "intValue": 0
      },
      {
        "id": "get0",
        "op": "TargetListGet"
      },
      {
        "id": "submit",
        "op": "SubmitCast",
        "orderTypeKey": "castAbility"
      },
      {
        "id": "ok",
        "op": "ConstInt",
        "intValue": 1
      },
      {
        "id": "halt",
        "op": "HaltReturnInt"
      }
    ],
    "controlEdges": [
      {
        "from": "caster",
        "fromPort": "next",
        "to": "slot"
      },
      {
        "from": "slot",
        "fromPort": "next",
        "to": "enemies"
      },
      {
        "from": "enemies",
        "fromPort": "next",
        "to": "enemyTeam"
      },
      {
        "from": "enemyTeam",
        "fromPort": "next",
        "to": "idx0"
      },
      {
        "from": "idx0",
        "fromPort": "next",
        "to": "get0"
      },
      {
        "from": "get0",
        "fromPort": "next",
        "to": "submit"
      },
      {
        "from": "submit",
        "fromPort": "next",
        "to": "ok"
      },
      {
        "from": "ok",
        "fromPort": "next",
        "to": "halt"
      }
    ],
    "valueEdges": [
      {
        "from": "caster",
        "fromPort": "value",
        "to": "enemies",
        "toPort": "source"
      },
      {
        "from": "idx0",
        "fromPort": "value",
        "to": "get0",
        "toPort": "value"
      },
      {
        "from": "slot",
        "fromPort": "value",
        "to": "submit",
        "toPort": "value"
      },
      {
        "from": "get0",
        "fromPort": "value",
        "to": "submit",
        "toPort": "target"
      },
      {
        "from": "ok",
        "fromPort": "value",
        "to": "halt",
        "toPort": "value"
      }
    ]
  },
  {
