        "to": "ok"
      },
      {
        "from": "ok",
        "fromPort": "next",
        "to": "halt"
      }
    ],
    "valueEdges": [
      {
        "from": "read",
        "fromPort": "value",
        "to": "add",
        "toPort": "a"
      },
      {
        "from": "one",
        "fromPort": "value",
        "to": "add",
        "toPort": "b"
      },
      {
        "from": "add",
        "fromPort": "value",
        "to": "write",
        "toPort": "value"
      },
      {
        "from": "ok",
        "fromPort": "value",
        "to": "halt",
        "toPort": "value"
      }
    ]
  },
