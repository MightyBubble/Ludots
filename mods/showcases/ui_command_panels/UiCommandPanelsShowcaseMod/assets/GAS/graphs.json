[
  {
    "id": "Graph.Ucp.OpenPanels",
    "kind": "TriggerGraph",
    "entries": [
      {
        "label": "on_map_loaded",
        "event": "MapLoaded",
        "start": "scope",
        "once": true
      }
    ],
    "nodes": [
      {
        "id": "scope",
        "op": "LoadExplicitTarget"
      },
      {
        "id": "create_skills",
        "op": "CreatePanel",
        "panelType": "panel.ucp.skills",
        "panelAnchor": "screen.bottomLeft"
      },
      {
        "id": "show_skills",
        "op": "ShowPanel",
        "panelType": "panel.ucp.skills"
      },
      {
        "id": "create_command",
        "op": "CreatePanel",
        "panelType": "panel.ucp.command",
        "panelAnchor": "screen.bottomRight"
      },
      {
        "id": "show_command",
        "op": "ShowPanel",
        "panelType": "panel.ucp.command"
      },
      {
        "id": "ok",
        "op": "ConstInt",
        "intValue": 1
      },
      {
        "id": "halt",
        "op": "HaltReturnInt"
      }
    ],
    "controlEdges": [
      {
        "from": "scope",
        "fromPort": "next",
        "to": "create_skills"
      },
      {
        "from": "create_skills",
        "fromPort": "next",
        "to": "show_skills"
      },
      {
        "from": "show_skills",
        "fromPort": "next",
        "to": "create_command"
      },
      {
        "from": "create_command",
        "fromPort": "next",
        "to": "show_command"
      },
      {
        "from": "show_command",
        "fromPort": "next",
        "to": "ok"
      },
      {
        "from": "ok",
        "fromPort": "next",
        "to": "halt"
      }
    ],
    "valueEdges": [
      {
        "from": "scope",
        "fromPort": "value",
        "to": "create_skills",
        "toPort": "source"
      },
      {
        "from": "scope",
        "fromPort": "value",
        "to": "create_command",
        "toPort": "source"
      },
      {
        "from": "ok",
        "fromPort": "value",
        "to": "halt",
        "toPort": "value"
      }
    ]
  },
  {
    "id": "Graph.Ucp.Skills",
    "kind": "Query",
    "entry": "caster",
    "nodes": [
      {
        "id": "caster",
        "op": "LoadCaster"
      },
      {
        "id": "slots",
        "op": "QueryCollectAbilitySlots"
      },
      {
        "id": "ready",
        "op": "LoadSelfAttribute",
        "attribute": "Health"
      }
    ],
    "controlEdges": [
      {
        "from": "caster",
        "fromPort": "next",
        "to": "slots"
      },
      {
        "from": "slots",
        "fromPort": "next",
        "to": "ready"
      }
    ],
    "valueEdges": [
      {
        "from": "caster",
        "fromPort": "value",
        "to": "slots",
        "toPort": "source"
      }
    ],
    "outputs": [
      {
        "id": "slots",
        "destination": "AbilitySlotCollection",
        "type": "IntIdList",
        "collectionKey": "ucp.slots",
        "role": "Display",
        "title": "技能槽",
        "summary": "指挥官身上的有效技能槽"
      },
      {
        "id": "ready",
        "destination": "Summary",
        "type": "Float",
        "source": "ready",
        "key": "ucp.skills.ready"
      }
    ]
  },
  {
    "id": "Graph.Ucp.Chip",
    "kind": "Query",
    "entry": "ready",
    "nodes": [
      {
        "id": "ready",
        "op": "LoadSelfAttribute",
        "attribute": "Health"
      }
    ],
    "controlEdges": [],
    "valueEdges": [],
    "outputs": [
      {
        "id": "ready",
        "destination": "Summary",
        "type": "Float",
        "source": "ready",
        "key": "ucp.chip.ready"
      }
    ]
  },
  {
    "id": "Graph.Ucp.Command",
