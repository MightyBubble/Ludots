{
  "actions": [
    { "id": "CaseE.BoxSelectBegin", "name": "CaseE_BoxSelectBegin", "type": "Button" },
    { "id": "CaseE.BoxSelect", "name": "CaseE_BoxSelect", "type": "Button" },
    { "id": "CaseE.TapSelect", "name": "CaseE_TapSelect", "type": "Button" },
    { "id": "CaseE.Pointer", "name": "CaseE_Pointer", "type": "Axis2D" }
  ],
  "contexts": [
    {
      "id": "CaseE.Controls",
      "name": "Case E Selection Controls",
      "priority": 60,
      "bindings": [
        {
          "actionId": "CaseE.BoxSelectBegin",
          "path": "<Mouse>/leftButton"
        },
        {
