          ]
        },
        {
          "actionId": "CaseE.TapSelect",
          "path": "<Mouse>/leftButton",
          "interactions": [
            { "type": "Tap" }
          ]
        },
        {
          "actionId": "CaseE.Pointer",
          "path": "<Mouse>/Pos"
        },
        {
          "actionId": "QueueModifier",
          "path": "<Keyboard>/leftShift"
        },
        {
          "actionId": "PrecisionModifier",
          "path": "<Keyboard>/leftCtrl"
        },
        {
          "actionId": "ModifierSubtract",
          "path": "<Keyboard>/leftAlt"
        }
      ]
    }
