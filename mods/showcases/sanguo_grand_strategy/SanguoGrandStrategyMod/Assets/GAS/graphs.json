                            "summary":  "Wei-held cities with at least 5000 troops."
                        },
                        {
                            "id":  "cityCount",
                            "destination":  "Summary",
                            "type":  "Int",
                            "source":  "cityCount",
                            "key":  "sanguo.summary.weiFrontierCount"
                        },
                        {
                            "id":  "totalTroops",
                            "destination":  "Summary",
                            "type":  "Float",
                            "source":  "totalTroops",
                            "key":  "sanguo.summary.weiTroops"
                        },
                        {
                            "id":  "strongestCity",
                            "destination":  "Summary",
                            "type":  "Entity",
                            "source":  "strongestCity",
                            "key":  "sanguo.summary.weiStrongestCity"
                        }
                    ]
    }
]

