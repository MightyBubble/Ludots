[
  {
    "id": "Graph.CollectionBags.Panels.Open",
    "kind": "TriggerGraph",
    "entries": [
      { "label": "on_map_loaded", "event": "MapLoaded", "start": "scope", "once": true }
    ],
    "nodes": [
      { "id": "scope", "op": "LoadExplicitTarget" },
      { "id": "createEffects", "op": "CreatePanel", "panelType": "panel.collection.effects", "panelAnchor": "screen.topLeft" },
      { "id": "showEffects", "op": "ShowPanel", "panelType": "panel.collection.effects" },
      { "id": "createAbilities", "op": "CreatePanel", "panelType": "panel.collection.abilities", "panelAnchor": "screen.topCenter" },
      { "id": "showAbilities", "op": "ShowPanel", "panelType": "panel.collection.abilities" },
      { "id": "createTags", "op": "CreatePanel", "panelType": "panel.collection.tags", "panelAnchor": "screen.topRight" },
      { "id": "showTags", "op": "ShowPanel", "panelType": "panel.collection.tags" },
      { "id": "ok", "op": "ConstInt", "intValue": 1 },
      { "id": "halt", "op": "HaltReturnInt" }
    ],
    "controlEdges": [
      { "from": "scope", "fromPort": "next", "to": "createEffects" },
      { "from": "createEffects", "fromPort": "next", "to": "showEffects" },
      { "from": "showEffects", "fromPort": "next", "to": "createAbilities" },
      { "from": "createAbilities", "fromPort": "next", "to": "showAbilities" },
      { "from": "showAbilities", "fromPort": "next", "to": "createTags" },
      { "from": "createTags", "fromPort": "next", "to": "showTags" },
      { "from": "showTags", "fromPort": "next", "to": "ok" },
      { "from": "ok", "fromPort": "next", "to": "halt" }
    ],
    "valueEdges": [
      { "from": "scope", "fromPort": "value", "to": "createEffects", "toPort": "source" },
      { "from": "scope", "fromPort": "value", "to": "createAbilities", "toPort": "source" },
      { "from": "scope", "fromPort": "value", "to": "createTags", "toPort": "source" },
      { "from": "ok", "fromPort": "value", "to": "halt", "toPort": "value" }
    ]
  },
  {
    "id": "Graph.CollectionBags.EffectTemplates",
    "kind": "Query",
    "entry": "templates",
    "nodes": [
      { "id": "templates", "op": "QueryCollectEffectTemplates" }
    ],
    "controlEdges": [],
    "valueEdges": [],
    "outputs": [
      {
        "id": "templates",
        "destination": "EffectTemplateCollection",
        "type": "IntIdList",
        "collectionKey": "panel.collection.effectTemplates",
        "role": "Display",
        "title": "效果图鉴",
        "summary": "已注册效果模板"
      }
    ]
  },
  {
    "id": "Graph.CollectionBags.AbilitySlots",
    "kind": "Query",
    "entry": "caster",
    "nodes": [
      { "id": "caster", "op": "LoadCaster" },
      { "id": "slots", "op": "QueryCollectAbilitySlots" }
    ],
    "controlEdges": [
      { "from": "caster", "fromPort": "next", "to": "slots" }
    ],
    "valueEdges": [
      { "from": "caster", "fromPort": "value", "to": "slots", "toPort": "source" }
    ],
    "outputs": [
      {
        "id": "slots",
        "destination": "AbilitySlotCollection",
        "type": "IntIdList",
        "collectionKey": "panel.collection.abilitySlots",
        "role": "Display",
        "title": "技能格",
        "summary": "名册守望者的有效技能槽"
      }
    ]
  },
  {
    "id": "Graph.CollectionBags.PresentTags",
    "kind": "Query",
    "entry": "caster",
    "nodes": [
      { "id": "caster", "op": "LoadCaster" },
      { "id": "tags", "op": "QueryCollectPresentTags" }
    ],
    "controlEdges": [
      { "from": "caster", "fromPort": "next", "to": "tags" }
    ],
    "valueEdges": [
      { "from": "caster", "fromPort": "value", "to": "tags", "toPort": "source" }
    ],
    "outputs": [
      {
        "id": "tags",
        "destination": "TagIdCollection",
        "type": "IntIdList",
        "collectionKey": "panel.collection.presentTags",
        "role": "Display",
        "title": "身上的印记",
        "summary": "名册守望者当前拥有的标签"
      }
    ]
  },
  {
    "id": "Graph.CollectionBags.Chip",
    "kind": "Query",
    "entry": "ready",
    "nodes": [
      { "id": "ready", "op": "ConstInt", "intValue": 1 }
    ],
    "controlEdges": [],
    "valueEdges": [],
    "outputs": [
      {
        "id": "ready",
        "destination": "Summary",
        "type": "Int",
        "source": "ready",
        "key": "panel.collection.chip.ready"
      }
    ]
  }
]
