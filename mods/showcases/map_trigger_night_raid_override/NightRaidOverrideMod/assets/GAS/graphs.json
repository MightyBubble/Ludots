        "once": true
      },
      {
        "label": "override_kill_tool",
        "event": "NightRaid.KillTool.Used",
        "start": "ov_kt_scope",
        "refire": "restart"
      }
    ],
    "nodes": [
      {
        "id": "ov_scope",
        "op": "LoadExplicitTarget"
      },
      {
        "id": "ov_one",
        "op": "ConstInt",
        "intValue": 1
      },
      {
        "id": "ov_write_active",
        "op": "WriteMapVarInt",
        "var": "override_active"
      },
      {
        "id": "ov_done_const",
        "op": "ConstInt",
        "intValue": 1
      },
      {
        "id": "ov_done",
        "op": "HaltReturnInt"
      },
      {
        "id": "ov_kt_scope",
        "op": "LoadExplicitTarget"
      },
      {
        "id": "ov_kt_read",
        "op": "ReadMapVarInt",
        "var": "override_seen"
      },
      {
        "id": "ov_kt_one",
        "op": "ConstInt",
        "intValue": 1
      },
      {
        "id": "ov_kt_add",
        "op": "AddInt"
      },
      {
        "id": "ov_kt_write",
        "op": "WriteMapVarInt",
        "var": "override_seen"
      },
      {
        "id": "ov_kt_const",
        "op": "ConstInt",
        "intValue": 1
      },
      {
        "id": "ov_kt_done",
        "op": "HaltReturnInt"
      }
    ],
    "controlEdges": [
