        "intValue": 1
      },
      {
        "id": "pr_write",
        "op": "WriteMapVarInt",
        "var": "probe_hero_entered"
      },
      {
        "id": "pr_done_const",
        "op": "ConstInt",
        "intValue": 1
      },
      {
        "id": "pr_done",
        "op": "HaltReturnInt"
      }
    ],
    "controlEdges": [
      {
        "from": "pc_read",
        "fromPort": "next",
        "to": "pc_scope"
      },
      {
        "from": "pc_scope",
        "fromPort": "next",
        "to": "pc_write"
      },
      {
        "from": "pc_write",
        "fromPort": "next",
        "to": "pc_done_const"
      },
      {
        "from": "pc_done_const",
        "fromPort": "next",
        "to": "pc_done"
      },
      {
        "from": "pr_scope",
        "fromPort": "next",
        "to": "pr_one"
      },
      {
        "from": "pr_one",
        "fromPort": "next",
        "to": "pr_write"
      },
      {
        "from": "pr_write",
        "fromPort": "next",
        "to": "pr_done_const"
      },
      {
        "from": "pr_done_const",
        "fromPort": "next",
        "to": "pr_done"
