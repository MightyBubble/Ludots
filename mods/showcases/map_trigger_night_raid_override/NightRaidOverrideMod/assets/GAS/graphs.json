        "start": "ov_kt_scope",
        "refire": "restart"
      }
    ],
    "nodes": [
      {
        "id": "ov_scope",
        "op": "LoadExplicitTarget"
      },
      {
        "id": "ov_one",
        "op": "ConstInt",
