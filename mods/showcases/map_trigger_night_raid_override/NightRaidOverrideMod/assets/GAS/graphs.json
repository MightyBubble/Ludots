    "valueEdges": [
      {
        "from": "pc_read",
        "fromPort": "value",
        "to": "pc_write",
        "toPort": "value"
      },
      {
        "from": "pc_scope",
        "fromPort": "value",
        "to": "pc_write",
        "toPort": "source"
      },
      {
        "from": "pr_scope",
        "fromPort": "value",
        "to": "pr_write",
        "toPort": "source"
      },
      {
        "from": "pr_one",
        "fromPort": "value",
        "to": "pr_write",
        "toPort": "value"
      }
    ]
