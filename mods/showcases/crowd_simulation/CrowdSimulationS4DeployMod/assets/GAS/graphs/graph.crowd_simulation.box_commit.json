[
  {
    "id": "graph.crowd_simulation.box_commit",
    "kind": "TriggerGraph",
    "entries": [
      {
        "label": "on_box_select_release",
        "start": "read_modifiers",
        "refire": "restart",
        "action": "CrowdSimulation.BoxSelectEnd"
      }
    ],
    "nodes": [
      { "id": "read_modifiers", "op": "LoadEntryPayloadInt", "payloadKey": "MapTrigger.Modifiers" },
      { "id": "rep", "op": "LoadEntryPayloadEntity", "payloadKey": "MapTrigger.Rep" },
      { "id": "write_modifiers", "op": "WriteBlackboardInt", "blackboardKey": "crowd_simulation.select.modifiers" },
      { "id": "run_hit", "op": "InvokeGraph", "functionName": "graph.crowd_simulation.box_hit" },
      { "id": "rep_after", "op": "LoadEntryPayloadEntity", "payloadKey": "MapTrigger.Rep" },
      { "id": "read_stored", "op": "ReadBlackboardInt", "blackboardKey": "crowd_simulation.select.modifiers" },
      { "id": "modifier_switch", "op": "SwitchInt" },
      { "id": "op_replace", "op": "ConstInt", "intValue": 0 },
      { "id": "commit_replace", "op": "WriteCollection", "collectionKey": "selected" },
      { "id": "op_add", "op": "ConstInt", "intValue": 1 },
      { "id": "commit_add", "op": "WriteCollection", "collectionKey": "selected" },
      { "id": "op_subtract", "op": "ConstInt", "intValue": 2 },
      { "id": "commit_subtract", "op": "WriteCollection", "collectionKey": "selected" },
      { "id": "deactivate_boxing", "op": "DeactivateContext", "context": "interaction.context.crowd_simulation.boxing" },
      { "id": "ok", "op": "ConstInt", "intValue": 1 },
      { "id": "halt", "op": "HaltReturnInt" }
    ],
    "controlEdges": [
      { "from": "read_modifiers", "fromPort": "next", "to": "rep" },
      { "from": "rep", "fromPort": "next", "to": "write_modifiers" },
      { "from": "write_modifiers", "fromPort": "next", "to": "run_hit" },
      { "from": "run_hit", "fromPort": "next", "to": "rep_after" },
      { "from": "rep_after", "fromPort": "next", "to": "read_stored" },
      { "from": "read_stored", "fromPort": "next", "to": "modifier_switch" },
      { "from": "modifier_switch", "fromPort": "case:1", "to": "op_add" },
      { "from": "modifier_switch", "fromPort": "case:3", "to": "op_add" },
      { "from": "modifier_switch", "fromPort": "case:4", "to": "op_subtract" },
      { "from": "modifier_switch", "fromPort": "case:5", "to": "op_subtract" },
      { "from": "modifier_switch", "fromPort": "case:6", "to": "op_subtract" },
      { "from": "modifier_switch", "fromPort": "case:7", "to": "op_subtract" },
      { "from": "modifier_switch", "fromPort": "default", "to": "op_replace" },
      { "from": "op_replace", "fromPort": "next", "to": "commit_replace" },
      { "from": "op_add", "fromPort": "next", "to": "commit_add" },
      { "from": "op_subtract", "fromPort": "next", "to": "commit_subtract" },
      { "from": "commit_replace", "fromPort": "next", "to": "deactivate_boxing" },
      { "from": "commit_add", "fromPort": "next", "to": "deactivate_boxing" },
      { "from": "commit_subtract", "fromPort": "next", "to": "deactivate_boxing" },
      { "from": "deactivate_boxing", "fromPort": "next", "to": "ok" },
      { "from": "ok", "fromPort": "next", "to": "halt" }
    ],
    "valueEdges": [
      { "from": "read_modifiers", "fromPort": "value", "to": "write_modifiers", "toPort": "value" },
      { "from": "rep", "fromPort": "value", "to": "write_modifiers", "toPort": "source" },
      { "from": "rep_after", "fromPort": "value", "to": "read_stored", "toPort": "source" },
      { "from": "rep_after", "fromPort": "value", "to": "commit_replace", "toPort": "source" },
      { "from": "rep_after", "fromPort": "value", "to": "commit_add", "toPort": "source" },
      { "from": "rep_after", "fromPort": "value", "to": "commit_subtract", "toPort": "source" },
      { "from": "read_stored", "fromPort": "value", "to": "modifier_switch", "toPort": "selector" },
      { "from": "op_replace", "fromPort": "value", "to": "commit_replace", "toPort": "value" },
      { "from": "op_add", "fromPort": "value", "to": "commit_add", "toPort": "value" },
      { "from": "op_subtract", "fromPort": "value", "to": "commit_subtract", "toPort": "value" },
      { "from": "ok", "fromPort": "value", "to": "halt", "toPort": "value" }
    ]
  }
]
