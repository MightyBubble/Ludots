[
  {
    "id": "crowd_minimal.units.bootstrap",
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "crowd_minimal.unit"
        },
        "condition": {
          "inline": "None"
        },
        "command": {
          "kind": "CreatePresenter",
          "definitionId": "crowd_minimal.unit",
          "scopeSource": "EventPayloadA"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "crowd_minimal.unit"
        },
        "command": {
          "kind": "DestroyPresenterScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ]
  },
  {
    "id": "crowd_minimal.unit",
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "crowd_minimal.unit.body",
          "materialId": "default_surface",
          "renderPath": "InstancedStaticMesh",
          "mobility": "Movable",
          "localOffset": [
            0,
            4,
            0
          ],
          "localScale": [
            12,
            8,
            12
          ],
          "colorParamKey": "crowd_minimal.unit.color"
        }
      },
      {
        "slot": "grounding",
        "kind": "Grounding",
        "activeByDefault": true,
        "grounding": {
          "mode": "SnapToGround",
          "offset": 0,
          "updatePolicy": "EveryFrame"
        }
      }
    ],
    "bindings": [
      {
        "paramKey": "crowd_minimal.unit.color",
        "source": "entityColorVector"
      }
    ],
    "paramDefaults": [
      {
        "paramKey": "crowd_minimal.unit.color",
        "lane": "Vector",
        "vectorValue": [
          1,
          1,
          1,
          1
        ]
      }
    ]
  }
]
