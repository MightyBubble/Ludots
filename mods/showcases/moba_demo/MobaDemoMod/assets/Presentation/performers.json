[
  {
    "id": "moba_unit_marker",
    "maxVisibilityDistanceCm": 8000,
    "visibility": {
      "inline": "OwnerCullVisible"
    },
    "bindings": [
      {
        "paramKey": "marker3d.color.r",
        "source": "entityColor",
        "sourceId": 0
      },
      {
        "paramKey": "marker3d.color.g",
        "source": "entityColor",
        "sourceId": 1
      },
      {
        "paramKey": "marker3d.color.b",
        "source": "entityColor",
        "sourceId": 2
      },
      {
        "paramKey": "marker3d.color.a",
        "source": "entityColor",
        "sourceId": 3
      }
    ],
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "*"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        },
        "command": {
          "kind": "CreatePerformer",
          "definitionId": "moba_unit_marker",
          "scopeSource": "EventPayloadA"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "*"
        },
        "command": {
          "kind": "DestroyPerformerScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "cube",
          "renderPath": "StaticMesh",
          "mobility": "Movable",
          "localScale": [
            0.35,
            0.35,
            0.35
          ]
        }
      }
    ],
    "anchor": {
      "offset": [
        0,
        0.25,
        0
      ]
    }
  },
  {
    "id": "moba_command_source_indicator",
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "sphere",
          "renderPath": "StaticMesh",
          "mobility": "Movable",
          "localScale": [
            0.18,
            0.18,
            0.18
          ]
        },
        "style": {
          "color": [
            1,
            1,
            0,
            1
          ]
        }
      }
    ],
    "lifecycle": {
      "persistence": "Scoped"
    },
    "anchor": {
      "offset": [
        0,
        0.85,
        0
      ]
    }
  },
  {
    "id": "moba_area_marker",
    "bindings": [
      {
        "paramKey": "marker3d.scale.x",
        "source": "constant",
        "constantValue": 1.2
      },
      {
        "paramKey": "marker3d.scale.y",
        "source": "constant",
        "constantValue": 0.08
      },
      {
        "paramKey": "marker3d.scale.z",
        "source": "constant",
        "constantValue": 1.2
      }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "sphere",
          "renderPath": "StaticMesh",
          "mobility": "Movable",
          "localScale": [
            1,
            1,
            1
          ]
        },
        "style": {
          "color": [
            0.8,
            0.2,
            1,
            0.75
          ],
          "alphaPolicy": "FadeOverLifetime"
        }
      }
    ],
    "lifecycle": {
      "durationSeconds": 0.35
    },
    "anchor": {
      "offset": [
        0,
        0.1,
        0
      ]
    }
  },
  {
    "id": "moba_ability_range",
