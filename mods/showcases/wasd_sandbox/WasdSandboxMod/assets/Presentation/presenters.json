[
  {
    "id": "wasd.character.static_body",
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "SkinnedMesh",
          "assetId": "sphere",
          "materialId": "default_surface",
          "renderPath": "SkinnedMesh",
          "mobility": "Movable",
          "localScale": [0.9, 0.9, 0.9]
        }
      }
    ]
  },
  {
    "id": "wasd.template.zhangsan_visual",
    "extends": "wasd.character.static_body",
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "wasd_zhangsan"
        },
        "command": {
          "kind": "CreatePresenter",
          "scopeSource": "EventPayloadA",
          "definitionId": "wasd.template.zhangsan_visual"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "wasd_zhangsan"
        },
        "command": {
          "kind": "DestroyPresenterScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ]
  },
  {
    "id": "wasd.template.lisi_visual",
    "extends": "wasd.character.static_body",
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "wasd_lisi"
        },
        "command": {
          "kind": "CreatePresenter",
          "scopeSource": "EventPayloadA",
          "definitionId": "wasd.template.lisi_visual"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        }
      },
      {
        "event": {
