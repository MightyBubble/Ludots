[
  {
    "id": "Graph.FieldJingYang.Flow",
    "kind": "TriggerGraph",
    "entries": [
      {
        "label": "on_map_loaded",
        "event": "MapLoaded",
        "start": "load_scope",
        "once": true
      },
      {
        "label": "on_enter_yang",
        "event": "FieldRegionEntered",
        "start": "enter_yang_scope",
        "refire": "restart",
        "filters": { "region": "yang" }
      },
      {
        "label": "on_enter_jing",
        "event": "FieldRegionEntered",
        "start": "enter_jing_scope",
        "refire": "restart",
        "filters": { "region": "jing" }
      },
      {
        "label": "on_exit_yang",
        "event": "FieldRegionExited",
        "start": "exit_yang_scope",
        "refire": "restart",
        "filters": { "region": "yang" }
      },
      {
        "label": "on_exit_jing",
        "event": "FieldRegionExited",
        "start": "exit_jing_scope",
        "refire": "restart",
        "filters": { "region": "jing" }
      }
    ],
    "nodes": [
      { "id": "load_scope", "op": "LoadExplicitTarget" },
      { "id": "load_one", "op": "ConstInt", "intValue": 1 },
      { "id": "write_stage_one", "op": "WriteMapVarInt", "var": "stage" },
      {
        "id": "progress_panel",
        "op": "CreatePanel",
        "panelType": "panel.field_jing_yang.progress",
        "panelAnchor": "screen.topLeft"
      },
      { "id": "progress_show", "op": "ShowPanel", "panelType": "panel.field_jing_yang.progress" },
      { "id": "load_ok", "op": "ConstInt", "intValue": 1 },
      { "id": "load_done", "op": "HaltReturnInt" },

      { "id": "enter_yang_scope", "op": "LoadExplicitTarget" },
      { "id": "enter_yang_code", "op": "ConstInt", "intValue": 2 },
      { "id": "write_region_yang", "op": "WriteMapVarInt", "var": "region_code" },
      { "id": "write_last_enter_yang", "op": "WriteMapVarInt", "var": "last_enter_code" },
      { "id": "enter_yang_inc_src", "op": "ReadMapVarInt", "var": "enter_count" },
      { "id": "enter_yang_one", "op": "ConstInt", "intValue": 1 },
      { "id": "enter_yang_sum", "op": "AddInt" },
      { "id": "write_enter_yang", "op": "WriteMapVarInt", "var": "enter_count" },
      { "id": "stage_yang", "op": "ConstInt", "intValue": 2 },
      { "id": "write_stage_yang", "op": "WriteMapVarInt", "var": "stage" },
      { "id": "enter_yang_ok", "op": "ConstInt", "intValue": 1 },
      { "id": "enter_yang_done", "op": "HaltReturnInt" },

      { "id": "enter_jing_scope", "op": "LoadExplicitTarget" },
      { "id": "enter_jing_code", "op": "ConstInt", "intValue": 1 },
      { "id": "write_region_jing", "op": "WriteMapVarInt", "var": "region_code" },
      { "id": "write_last_enter_jing", "op": "WriteMapVarInt", "var": "last_enter_code" },
      { "id": "enter_jing_inc_src", "op": "ReadMapVarInt", "var": "enter_count" },
      { "id": "enter_jing_one", "op": "ConstInt", "intValue": 1 },
      { "id": "enter_jing_sum", "op": "AddInt" },
      { "id": "write_enter_jing", "op": "WriteMapVarInt", "var": "enter_count" },
      { "id": "stage_jing", "op": "ConstInt", "intValue": 3 },
      { "id": "write_stage_jing", "op": "WriteMapVarInt", "var": "stage" },
      { "id": "enter_jing_ok", "op": "ConstInt", "intValue": 1 },
      { "id": "enter_jing_done", "op": "HaltReturnInt" },

      { "id": "exit_yang_scope", "op": "LoadExplicitTarget" },
      { "id": "exit_yang_code", "op": "ConstInt", "intValue": 2 },
      { "id": "write_last_exit_yang", "op": "WriteMapVarInt", "var": "last_exit_code" },
      { "id": "exit_yang_inc_src", "op": "ReadMapVarInt", "var": "exit_count" },
      { "id": "exit_yang_one", "op": "ConstInt", "intValue": 1 },
      { "id": "exit_yang_sum", "op": "AddInt" },
      { "id": "write_exit_yang", "op": "WriteMapVarInt", "var": "exit_count" },
      { "id": "exit_yang_ok", "op": "ConstInt", "intValue": 1 },
      { "id": "exit_yang_done", "op": "HaltReturnInt" },

      { "id": "exit_jing_scope", "op": "LoadExplicitTarget" },
      { "id": "exit_jing_code", "op": "ConstInt", "intValue": 1 },
