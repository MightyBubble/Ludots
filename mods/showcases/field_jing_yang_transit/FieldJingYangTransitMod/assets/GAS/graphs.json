      { "from": "region_rd", "fromPort": "next", "to": "enter_rd" },
      { "from": "enter_rd", "fromPort": "next", "to": "exit_rd" }
    ],
    "valueEdges": [],
    "outputs": [
      { "id": "stage", "destination": "Summary", "type": "Int", "source": "stage_rd", "key": "field.jingyang.panel.stage" },
      { "id": "regionCode", "destination": "Summary", "type": "Int", "source": "region_rd", "key": "field.jingyang.panel.regionCode" },
      { "id": "enterCount", "destination": "Summary", "type": "Int", "source": "enter_rd", "key": "field.jingyang.panel.enterCount" },
      { "id": "exitCount", "destination": "Summary", "type": "Int", "source": "exit_rd", "key": "field.jingyang.panel.exitCount" }
    ]
