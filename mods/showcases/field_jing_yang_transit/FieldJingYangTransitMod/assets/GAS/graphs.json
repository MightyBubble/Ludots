      { "from": "write_enter_yang", "fromPort": "next", "to": "stage_yang" },
      { "from": "stage_yang", "fromPort": "next", "to": "write_stage_yang" },
      { "from": "write_stage_yang", "fromPort": "next", "to": "enter_yang_ok" },
      { "from": "enter_yang_ok", "fromPort": "next", "to": "enter_yang_done" },

      { "from": "enter_jing_scope", "fromPort": "next", "to": "enter_jing_code" },
      { "from": "enter_jing_code", "fromPort": "next", "to": "write_region_jing" },
      { "from": "write_region_jing", "fromPort": "next", "to": "write_last_enter_jing" },
      { "from": "write_last_enter_jing", "fromPort": "next", "to": "enter_jing_inc_src" },
