      { "from": "enter_jing_one", "fromPort": "next", "to": "enter_jing_sum" },
      { "from": "enter_jing_sum", "fromPort": "next", "to": "write_enter_jing" },
      { "from": "write_enter_jing", "fromPort": "next", "to": "stage_jing" },
      { "from": "stage_jing", "fromPort": "next", "to": "write_stage_jing" },
      { "from": "write_stage_jing", "fromPort": "next", "to": "enter_jing_ok" },
      { "from": "enter_jing_ok", "fromPort": "next", "to": "enter_jing_done" },

