      { "from": "exit_yang_inc_src", "fromPort": "next", "to": "exit_yang_one" },
      { "from": "exit_yang_one", "fromPort": "next", "to": "exit_yang_sum" },
      { "from": "exit_yang_sum", "fromPort": "next", "to": "write_exit_yang" },
      { "from": "write_exit_yang", "fromPort": "next", "to": "exit_yang_ok" },
      { "from": "exit_yang_ok", "fromPort": "next", "to": "exit_yang_done" },

      { "from": "exit_jing_scope", "fromPort": "next", "to": "exit_jing_code" },
      { "from": "exit_jing_code", "fromPort": "next", "to": "write_last_exit_jing" },
      { "from": "write_last_exit_jing", "fromPort": "next", "to": "exit_jing_inc_src" },
      { "from": "exit_jing_inc_src", "fromPort": "next", "to": "exit_jing_one" },
      { "from": "exit_jing_one", "fromPort": "next", "to": "exit_jing_sum" },
      { "from": "exit_jing_sum", "fromPort": "next", "to": "write_exit_jing" },
      { "from": "write_exit_jing", "fromPort": "next", "to": "exit_jing_ok" },
      { "from": "exit_jing_ok", "fromPort": "next", "to": "exit_jing_done" }
    ],
    "valueEdges": [
      { "from": "load_one", "fromPort": "value", "to": "write_stage_one", "toPort": "value" },
      { "from": "load_ok", "fromPort": "value", "to": "load_done", "toPort": "value" },

      { "from": "enter_yang_code", "fromPort": "value", "to": "write_region_yang", "toPort": "value" },
      { "from": "enter_yang_code", "fromPort": "value", "to": "write_last_enter_yang", "toPort": "value" },
      { "from": "enter_yang_inc_src", "fromPort": "value", "to": "enter_yang_sum", "toPort": "a" },
      { "from": "enter_yang_one", "fromPort": "value", "to": "enter_yang_sum", "toPort": "b" },
      { "from": "enter_yang_sum", "fromPort": "value", "to": "write_enter_yang", "toPort": "value" },
      { "from": "stage_yang", "fromPort": "value", "to": "write_stage_yang", "toPort": "value" },
      { "from": "enter_yang_ok", "fromPort": "value", "to": "enter_yang_done", "toPort": "value" },

      { "from": "enter_jing_code", "fromPort": "value", "to": "write_region_jing", "toPort": "value" },
      { "from": "enter_jing_code", "fromPort": "value", "to": "write_last_enter_jing", "toPort": "value" },
      { "from": "enter_jing_inc_src", "fromPort": "value", "to": "enter_jing_sum", "toPort": "a" },
      { "from": "enter_jing_one", "fromPort": "value", "to": "enter_jing_sum", "toPort": "b" },
      { "from": "enter_jing_sum", "fromPort": "value", "to": "write_enter_jing", "toPort": "value" },
      { "from": "stage_jing", "fromPort": "value", "to": "write_stage_jing", "toPort": "value" },
      { "from": "enter_jing_ok", "fromPort": "value", "to": "enter_jing_done", "toPort": "value" },

      { "from": "exit_yang_code", "fromPort": "value", "to": "write_last_exit_yang", "toPort": "value" },
      { "from": "exit_yang_inc_src", "fromPort": "value", "to": "exit_yang_sum", "toPort": "a" },
      { "from": "exit_yang_one", "fromPort": "value", "to": "exit_yang_sum", "toPort": "b" },
      { "from": "exit_yang_sum", "fromPort": "value", "to": "write_exit_yang", "toPort": "value" },
      { "from": "exit_yang_ok", "fromPort": "value", "to": "exit_yang_done", "toPort": "value" },

      { "from": "exit_jing_code", "fromPort": "value", "to": "write_last_exit_jing", "toPort": "value" },
      { "from": "exit_jing_inc_src", "fromPort": "value", "to": "exit_jing_sum", "toPort": "a" },
      { "from": "exit_jing_one", "fromPort": "value", "to": "exit_jing_sum", "toPort": "b" },
      { "from": "exit_jing_sum", "fromPort": "value", "to": "write_exit_jing", "toPort": "value" },
      { "from": "exit_jing_ok", "fromPort": "value", "to": "exit_jing_done", "toPort": "value" }
    ]
  },
  {
    "id": "Graph.FieldJingYang.Panel.Values",
    "kind": "Query",
    "entry": "stage_rd",
    "nodes": [
      { "id": "stage_rd", "op": "ReadMapVarInt", "var": "stage" },
      { "id": "region_rd", "op": "ReadMapVarInt", "var": "region_code" },
      { "id": "enter_rd", "op": "ReadMapVarInt", "var": "enter_count" },
      { "id": "exit_rd", "op": "ReadMapVarInt", "var": "exit_count" }
    ],
    "controlEdges": [
