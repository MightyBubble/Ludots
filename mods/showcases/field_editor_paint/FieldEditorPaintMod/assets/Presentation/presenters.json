[
  {
    "id": "field_paint_bootstrap",
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "field_paint_hero"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        },
        "command": {
          "kind": "CreatePresenter",
          "definitionId": "field_paint_hero",
          "scopeSource": "EventPayloadA"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "field_paint_hero"
        },
        "command": {
          "kind": "DestroyPresenterScope",
          "scopeSource": "EventPayloadA"
        }
      },
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "field_paint_marker_a"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        },
        "command": {
          "kind": "CreatePresenter",
          "definitionId": "field_paint_marker_a",
          "scopeSource": "EventPayloadA"
        }
      },
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "field_paint_marker_b"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        },
        "command": {
          "kind": "CreatePresenter",
          "definitionId": "field_paint_marker_b",
          "scopeSource": "EventPayloadA"
        }
      }
    ]
  },
  {
    "id": "field_paint_hero",
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "field_paint.agent",
          "materialId": "default_surface",
          "renderPath": "InstancedStaticMesh",
          "mobility": "Movable",
          "localScale": [0.6, 1.2, 0.6]
        },
        "style": {
          "color": [0.95, 0.85, 0.2, 1]
        }
      },
      {
        "slot": "grounding",
        "kind": "Grounding",
        "activeByDefault": true,
        "grounding": {
          "mode": "SnapToGround",
          "offset": 0,
          "updatePolicy": "EveryFrame"
        }
      }
    ]
  },
  {
    "id": "field_paint_marker_a",
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "field_paint.marker",
          "materialId": "default_surface",
          "renderPath": "InstancedStaticMesh",
          "mobility": "Static",
          "localScale": [3.5, 0.2, 3.5]
        },
        "style": {
          "color": [0.2, 0.55, 0.95, 0.85]
        }
      },
      {
        "slot": "grounding",
        "kind": "Grounding",
        "activeByDefault": true,
        "grounding": {
          "mode": "SnapToGround",
          "offset": 0,
          "updatePolicy": "EveryFrame"
        }
      }
    ]
  },
  {
    "id": "field_paint_marker_b",
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "field_paint.marker",
          "materialId": "default_surface",
          "renderPath": "InstancedStaticMesh",
          "mobility": "Static",
          "localScale": [3.5, 0.2, 3.5]
        },
        "style": {
          "color": [0.9, 0.45, 0.2, 0.85]
