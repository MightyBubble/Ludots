[
  {
    "_comment": "RTS actor ground ring: always-on entity-scoped overlay so units/buildings remain readable on the grid.",
    "id": "rts_actor_ring",
    "maxVisibilityDistanceCm": 30000,
    "visibility": {
      "inline": "OwnerCullVisible"
    },
    "bindings": [
      {
        "paramKey": "groundOverlay.innerRadius",
        "source": "constant",
        "constantValue": 0.84
      },
      {
        "paramKey": "groundOverlay.border.r",
        "source": "entityColor",
        "sourceId": 0
      },
      {
        "paramKey": "groundOverlay.border.g",
        "source": "entityColor",
        "sourceId": 1
      },
      {
        "paramKey": "groundOverlay.border.b",
        "source": "entityColor",
        "sourceId": 2
      },
      {
        "paramKey": "groundOverlay.border.a",
        "source": "constant",
        "constantValue": 1
      },
      {
        "paramKey": "groundOverlay.border.width",
        "source": "constant",
        "constantValue": 0.08
      }
    ],
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "*"
        },
        "command": {
          "kind": "CreatePerformer",
          "scopeSource": "EventPayloadA",
          "definitionId": "rts_actor_ring"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "*"
        },
        "command": {
          "kind": "DestroyPerformerScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "GroundOverlay",
          "assetId": "Ring",
          "renderPath": "None",
          "mobility": "Movable",
          "localScale": [
            1.5,
            1.5,
            1.5
          ]
        },
        "style": {
          "color": [
            0.22,
            0.54,
            0.96,
            0.18
          ]
        }
      }
    ],
    "lifecycle": {
      "persistence": "Scoped"
    },
    "anchor": {
      "offset": [
        0,
        0.05,
        0
      ]
    }
  },
