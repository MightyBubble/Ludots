[
  {
    "id": "Dialogue.Chain.Opening",
    "displayName": "Relay Opening",
    "startNodeId": "open_root",
    "nodes": [
      {
        "id": "open_root",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "You keep the lamps on this ridge, {player}. Last night the relay — the wire of lanterns that carries the valley's word — woke on its own. Something out there wants reading. How do you take the watch?",
        "choices": [
          {
            "id": "open_listen",
            "text": "Read me the night's wire first.",
            "nextNodeId": "open_end"
          },
          {
            "id": "open_hurry",
            "text": "Skip the words — show me the lamps.",
            "nextNodeId": "open_end"
          }
        ]
      },
      {
        "id": "open_end",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "Then keep your eyes on the line. Three lamps will speak, and the third one is the one that matters.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          {
            "kind": "EmitSignal",
            "signalId": "chain.opened"
          }
        ]
      }
    ]
  },
  {
    "id": "Dialogue.Chain.Verdict",
    "displayName": "Relay Verdict",
    "startNodeId": "verdict_root",
    "nodes": [
      {
        "id": "verdict_root",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "The crew is back. The third lamp read only one word, and where that word goes is yours to choose.",
        "choices": [
          {
            "id": "verdict_seal",
            "text": "Seal the reading — keep it ours.",
            "nextNodeId": "verdict_seal_node"
          },
          {
            "id": "verdict_herald",
            "text": "Let the herald cry it — every lamp hears.",
            "nextNodeId": "verdict_herald_node"
          }
        ]
      },
      {
        "id": "verdict_seal_node",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "Sealed. The alarm ledger takes the page quietly — the ridge will sleep through the night.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          {
            "kind": "AddVariable",
            "variableId": "chain.lore",
            "valueKind": "Int",
            "intValue": 1
          },
          {
            "kind": "EmitSignal",
            "signalId": "chain.cmd.set_alarm"
          },
          {
            "kind": "EmitSignal",
            "signalId": "chain.finished"
          }
        ]
      },
      {
        "id": "verdict_herald_node",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "The herald takes the word to every lamp on the ridge. The valley will talk of nothing else tomorrow.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          {
            "kind": "EmitSignal",
            "signalId": "chain.event.herald"
          },
          {
            "kind": "EmitSignal",
            "signalId": "chain.finished"
          }
        ]
      }
    ]
  }
]
