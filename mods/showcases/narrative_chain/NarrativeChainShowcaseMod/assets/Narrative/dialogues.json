[
  {
    "id": "Dialogue.Chain.Opening",
    "displayName": "Relay Opening",
    "startNodeId": "open_root",
    "nodes": [
      {
        "id": "open_root",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "The valley relay woke up overnight. Pick how you want to hear it, {player}.",
        "choices": [
          {
            "id": "open_listen",
            "text": "Tell me what the relay heard.",
            "nextNodeId": "open_end"
          },
          {
            "id": "open_hurry",
            "text": "Skip to the showing.",
            "nextNodeId": "open_end"
          }
        ]
      },
      {
        "id": "open_end",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "Then watch the lamps. The relay will speak for itself.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          { "kind": "EmitSignal", "signalId": "chain.opened" }
        ]
      }
    ]
  },
  {
    "id": "Dialogue.Chain.Verdict",
    "displayName": "Relay Verdict",
    "startNodeId": "verdict_root",
    "nodes": [
      {
        "id": "verdict_root",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "The survey is logged. Now decide what the valley keeps.",
        "choices": [
          {
            "id": "verdict_seal",
            "text": "Seal the alarm ledger.",
            "nextNodeId": "verdict_seal_node"
          },
          {
            "id": "verdict_herald",
            "text": "Let the herald cry it aloud.",
            "nextNodeId": "verdict_herald_node"
          }
        ]
      },
      {
        "id": "verdict_seal_node",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "Sealed. The ledger turns one page quieter.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          { "kind": "AddVariable", "variableId": "chain.lore", "valueKind": "Int", "intValue": 1 },
          { "kind": "EmitSignal", "signalId": "chain.cmd.set_alarm" },
          { "kind": "EmitSignal", "signalId": "chain.finished" }
        ]
      },
      {
        "id": "verdict_herald_node",
        "speakerAlias": "warden",
        "speakerName": "Relay Warden",
        "text": "Then let every lamp on the ridge hear it.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          { "kind": "EmitSignal", "signalId": "chain.event.herald" },
          { "kind": "EmitSignal", "signalId": "chain.finished" }
        ]
      }
    ]
  }
]
