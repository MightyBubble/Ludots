  {
    "id": "lsw.unit_health_bar",
    "extends": "entity_health_bar",
    "visibility": {
      "inline": "None"
    },
    "maxVisibilityDistanceCm": 20000,
    "bindings": [
      {
        "paramKey": "worldBar.width",
        "source": "constant",
        "constantValue": 110
      },
      {
        "paramKey": "worldBar.height",
        "source": "constant",
        "constantValue": 14
      }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "WorldHud",
          "renderPath": "None",
          "mobility": "Movable",
          "localScale": [
            110,
            14,
            1
          ],
          "materialParamKey": "worldBar.fillRatio"
        },
        "style": {
          "color": [
            0.12,
            0.92,
            0.28,
            1
          ]
        }
      }
    ],
    "anchor": {
      "offset": [
        0,
        2.15,
        0
      ]
    }
  },
  {
    "id": "lsw.unit_health_text",
    "extends": "entity_world_text",
    "visibility": {
      "inline": "None"
    },
    "maxVisibilityDistanceCm": 20000,
    "behaviors": [
      {
        "slot": "body",
        "kind": "WorldText",
        "activeByDefault": true,
        "worldText": {
          "textToken": "hud.attribute.current_over_base",
          "mode": "AttributeCurrentOverBase",
          "fontSize": 22,
          "valueParamKey": "worldText.value0",
          "secondaryValueParamKey": "worldText.value1"
        },
        "style": {
          "color": [
            1,
            0.98,
            0.94,
            1
          ]
        }
      }
    ],
    "anchor": {
      "offset": [
        0,
        2.45,
        0
      ]
    }
  },
  {
    "id": "lsw.unit_chill_bar",
    "visibility": {
      "inline": "None"
    },
    "maxVisibilityDistanceCm": 20000,
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "WorldHud",
          "materialParamKey": "lsw.chill.ratio",
          "visibilityParamKey": "lsw.chill.visible",
