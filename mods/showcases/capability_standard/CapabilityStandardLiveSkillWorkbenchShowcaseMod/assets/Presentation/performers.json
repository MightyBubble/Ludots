        "style": {
          "color": [
            0.35,
            0.82,
            1,
            0.98
          ]
        }
      },
      {
        "slot": "tag",
        "kind": "TagBinding",
        "activeByDefault": true,
        "tagBinding": {
          "tagId": "State.LSW.Chilled",
          "targetParamKey": "lsw.chill.visible",
          "invertLogic": false
        }
      }
    ],
    "paramDefaults": [
      {
        "paramKey": "lsw.chill.ratio",
        "lane": "Float",
        "floatValue": 0
      },
      {
        "paramKey": "lsw.chill.visible",
        "lane": "Int",
        "intValue": 0
      }
    ],
    "anchor": {
      "offset": [
        0,
        2.75,
        0
      ]
    }
  },
