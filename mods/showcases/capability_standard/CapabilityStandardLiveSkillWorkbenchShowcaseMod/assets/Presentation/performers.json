          "invertLogic": false
        }
      }
    ],
    "paramDefaults": [
      {
        "paramKey": "lsw.chill.remainingSeconds",
        "lane": "Float",
        "floatValue": 0
      },
      {
        "paramKey": "lsw.chill.active",
