      "healthMax": 100
    },
    {
      "id": "boss_camp",
      "role": "target",
      "template": "GraphOps.Target",
      "name": "木桩大王",
      "x": 4,
      "y": 0,
      "health": 100,
      "healthMax": 100
    }
  ],
  "variables": [
    {
      "name": "gallery.offer_count",
      "type": "int",
      "initial": 0
    }
