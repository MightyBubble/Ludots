  "shortcuts": {
    "fatalDamage": "<Keyboard>/k",
    "thirst": "<Keyboard>/t",
    "reset": "<Keyboard>/r"
  },
  "states": [
    {
      "id": "Alive",
      "label": "Alive",
      "playerStory": "The actor can still react to water and movement rules."
    },
    {
      "id": "Hydrate",
      "parent": "Alive",
      "label": "Hydrate",
      "playerStory": "Water is low, so the parent state owns the drinking loop."
    },
    {
      "id": "Exercise",
      "parent": "Alive",
      "label": "Exercise",
      "playerStory": "Water is full enough, so the parent state owns the running loop."
    },
    {
      "id": "GoDrink",
      "parent": "Hydrate",
      "label": "Go Drink",
      "playerStory": "Water is low: the actor walks to the blue water station."
    },
    {
      "id": "Drinking",
      "parent": "Hydrate",
      "label": "Drinking",
      "playerStory": "The actor has arrived and stays still while water rises."
    },
    {
      "id": "GoTrack",
      "parent": "Exercise",
      "label": "Go Track",
      "playerStory": "Water is full: the actor leaves the station and walks to the track."
    },
    {
      "id": "Running",
      "parent": "Exercise",
      "label": "Running",
      "playerStory": "The actor runs laps and slowly spends water."
    },
    {
      "id": "Dead",
      "label": "Dead",
      "playerStory": "Any State won: the actor dies exactly where it stood."
    }
  ],
  "anyState": {
    "condition": "HealthAtOrBelowZero",
    "targetState": "Dead",
    "playerStory": "No matter what child state is active, health zero jumps to Dead."
  },
