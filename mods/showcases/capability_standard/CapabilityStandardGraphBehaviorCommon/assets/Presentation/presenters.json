[
  {
    "id": "graphops.hud.health_bar",
    "extends": "entity_health_bar",
    "bindings": [
      { "paramKey": "worldBar.width", "source": "constant", "constantValue": 90 },
      { "paramKey": "worldBar.height", "source": "constant", "constantValue": 12 }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "WorldHud",
          "renderPath": "None",
          "mobility": "Movable",
          "localScale": [90, 12, 1],
          "materialParamKey": "worldBar.fillRatio"
        },
        "style": { "color": [0.12, 0.92, 0.28, 1] }
      }
    ],
    "anchor": { "offset": [0, 2.35, 0] }
  },
  {
    "id": "graphops.hud.health_text",
    "extends": "entity_world_text",
    "behaviors": [
      {
        "slot": "body",
        "kind": "WorldText",
        "activeByDefault": true,
        "worldText": {
          "textToken": "hud.attribute.current_over_base",
          "mode": "AttributeCurrentOverBase",
          "fontSize": 18,
          "valueParamKey": "worldText.value0",
          "secondaryValueParamKey": "worldText.value1"
        },
        "style": { "color": [1, 0.98, 0.94, 1] }
      }
    ],
    "anchor": { "offset": [0, 2.65, 0] }
  },
  {
    "id": "graphops.visual.caster",
    "children": [
      { "definitionId": "graphops.hud.health_bar", "scopeTag": "hud" },
      { "definitionId": "graphops.hud.health_text", "scopeTag": "hud-text" }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "cube",
          "materialId": "default_surface",
          "renderPath": "InstancedStaticMesh",
          "mobility": "Movable",
          "localScale": [1.05, 2.2, 1.05]
        },
        "style": { "color": [1, 0.82, 0.2, 1] }
      }
    ],
    "rules": [
      {
        "event": { "kind": "EntitySpawned", "key": "GraphOps.Caster" },
        "condition": { "inline": "SourceHasVisualTransform" },
        "command": { "kind": "CreatePresenter", "scopeSource": "EventPayloadA", "definitionId": "graphops.visual.caster" }
      },
      {
        "event": { "kind": "EntityDestroyed", "key": "GraphOps.Caster" },
        "command": { "kind": "DestroyPresenterScope", "scopeSource": "EventPayloadA" }
      }
    ]
  },
  {
