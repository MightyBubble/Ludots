<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>bin\net8.0\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Libraries\Ludots.DataSchemaWorkbench\Ludots.DataSchemaWorkbench.csproj" />
  </ItemGroup>

  <!-- Ensure the workbench assembly is the mod entry DLL that ModLoader scans. -->
  <Target Name="PublishWorkbenchAsModMain" AfterTargets="Build">
    <PropertyGroup>
      <_WorkbenchDll>$(OutputPath)Ludots.DataSchemaWorkbench.dll</_WorkbenchDll>
      <_WorkbenchPdb>$(OutputPath)Ludots.DataSchemaWorkbench.pdb</_WorkbenchPdb>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WorkbenchDll)')" Text="Expected workbench DLL at $(_WorkbenchDll)" />
  </Target>

</Project>
