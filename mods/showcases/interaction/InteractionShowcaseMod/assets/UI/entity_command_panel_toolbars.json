          "pref": { "key": "pref.aim.cast_mode", "value": "interaction.context.aim.smart" }
        }
      },
      {
        "id": "Interaction.Mode.SC2",
        "label": "SC2 / Aim Cast",
        "actionId": "Aim.CastMode.AimClick",
        "highlight": {
          "pref": { "key": "pref.aim.cast_mode", "value": "interaction.context.aim.click" }
        }
      },
      {
        "id": "Interaction.Mode.Indicator",
        "label": "LoL / Indicator Release",
        "actionId": "Aim.CastMode.AimRelease",
        "highlight": {
          "pref": { "key": "pref.aim.cast_mode", "value": "interaction.context.aim.release" }
        }
      },
      {
        "id": "Interaction.Mode.Action",
        "label": "Action / Context Scored",
        "actionId": "InteractionModeAction",
