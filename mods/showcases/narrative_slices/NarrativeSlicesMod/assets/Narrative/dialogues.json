[
  {
    "id": "Dialogue.Slice.Gate",
    "displayName": "Gallery Gate",
    "startNodeId": "gate_root",
    "nodes": [
      {
        "id": "gate_root",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "Welcome to the gallery. This page shows how choice works: one line stays sealed until you hold a little lore. Take the open line first, earn the lore, and the sealed line will let you in.",
        "choices": [
          {
            "id": "open_yes",
            "text": "Take the open page.",
            "nextNodeId": "node_grant"
          },
          {
            "id": "open_locked",
            "text": "Read the sealed margin note.",
            "nextNodeId": "node_seal",
            "conditions": [
              {
                "kind": "Variable",
                "variableId": "gallery_lore",
                "operator": "GreaterOrEqual",
                "intValue": 1
              }
            ]
          }
        ]
      },
      {
        "id": "node_grant",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "Granted — one page of lore enters your keeping. Come back and the sealed line will open.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          {
            "kind": "AddVariable",
            "variableId": "gallery_lore",
            "valueKind": "Int",
            "intValue": 1
          },
          {
            "kind": "EmitSignal",
            "signalId": "slice.gate.granted"
          }
        ]
      },
      {
        "id": "node_seal",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "The sealed line opens to you now. The gallery's first page is complete.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          {
            "kind": "EmitSignal",
            "signalId": "slice.gate.finished"
          }
        ]
      }
    ]
  },
  {
    "id": "Dialogue.Slice.Gallery",
    "displayName": "Action Gallery",
    "startNodeId": "gallery_setvar",
    "nodes": [
      {
        "id": "gallery_setvar",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "Watch the ink: the keeper sets the counter to seven.",
        "autoAdvanceSeconds": 0.1,
        "nextNodeId": "gallery_addvar",
        "onEnter": [
          {
            "kind": "SetVariable",
            "variableId": "slice_var",
            "valueKind": "Int",
            "intValue": 7
          }
        ]
      },
      {
        "id": "gallery_addvar",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "One more stroke — the counter reads eight.",
        "autoAdvanceSeconds": 0.1,
        "nextNodeId": "gallery_start_alpha",
        "onEnter": [
          {
            "kind": "AddVariable",
            "variableId": "slice_var",
            "valueKind": "Int",
            "intValue": 1
          }
        ]
      },
      {
        "id": "gallery_start_alpha",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "He opens the first errand, Alpha — a small task with a sure end.",
        "autoAdvanceSeconds": 0.1,
        "nextNodeId": "gallery_complete_alpha",
        "onEnter": [
          {
            "kind": "StartTask",
            "taskId": "Slice.Gallery.Alpha"
          }
        ]
      },
      {
        "id": "gallery_complete_alpha",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "Alpha is done, and the ledger stamps it complete.",
        "autoAdvanceSeconds": 0.1,
        "nextNodeId": "gallery_start_beta",
        "onEnter": [
          {
            "kind": "CompleteTask",
            "taskId": "Slice.Gallery.Alpha"
          }
        ]
      },
      {
        "id": "gallery_start_beta",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "Now Beta — an errand the keeper means to lose.",
        "autoAdvanceSeconds": 0.1,
        "nextNodeId": "gallery_fail_beta",
        "onEnter": [
          {
            "kind": "StartTask",
            "taskId": "Slice.Gallery.Beta"
          }
        ]
      },
      {
        "id": "gallery_fail_beta",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "Beta fails, as intended: the ledger keeps failed pages too. That is worth seeing.",
        "autoAdvanceSeconds": 0.1,
        "nextNodeId": "gallery_camera_on",
        "onEnter": [
          {
            "kind": "FailTask",
            "taskId": "Slice.Gallery.Beta"
          }
        ]
      },
      {
        "id": "gallery_camera_on",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "He lifts the close-looking glass to study the page.",
        "autoAdvanceSeconds": 0.1,
        "nextNodeId": "gallery_camera_clear",
        "onEnter": [
          {
            "kind": "ActivateCamera",
            "cameraId": "Camera.Profile.Inspect"
          }
        ]
      },
      {
        "id": "gallery_camera_clear",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "And sets it down — the wide view returns.",
        "autoAdvanceSeconds": 0.1,
        "nextNodeId": "gallery_done",
        "onEnter": [
          {
            "kind": "ClearCamera"
          }
        ]
      },
      {
        "id": "gallery_done",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "The gallery's ledger closes for now.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          {
            "kind": "EmitSignal",
            "signalId": "slice.gallery.done"
          }
        ]
      }
    ]
  },
  {
    "id": "Dialogue.Slice.MapTrigger",
    "displayName": "Map Variable Trigger",
    "startNodeId": "map_trigger_root",
    "nodes": [
      {
        "id": "map_trigger_root",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "The ledger taps the valley's counter. Watch it move.",
        "autoAdvanceSeconds": 0.1,
        "onEnter": [
          {
            "kind": "EmitSignal",
            "signalId": "slice.map.write"
          }
        ]
      }
    ]
  },
  {
    "id": "Dialogue.Slice.MapEven",
    "displayName": "Map Even Branch",
    "startNodeId": "map_even_root",
    "nodes": [
      {
        "id": "map_even_root",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "The counter lands on two — an even count, and the even page opens."
      }
    ]
  },
  {
    "id": "Dialogue.Slice.MapOdd",
    "displayName": "Map Odd Branch",
    "startNodeId": "map_odd_root",
    "nodes": [
      {
        "id": "map_odd_root",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "The counter tips to three — an odd count, and the odd page opens."
      }
    ]
  },
  {
    "id": "Dialogue.Slice.RulesIntro",
    "displayName": "Bell Rules",
    "startNodeId": "rules_intro_root",
    "nodes": [
      {
        "id": "rules_intro_root",
        "speakerAlias": "keeper",
        "speakerName": "Gallery Keeper",
        "text": "This page needs no choice — just listen. Either bell is enough to close it.",
        "autoAdvanceSeconds": 0.4,
        "onEnter": [
          {
            "kind": "StartTask",
            "taskId": "Slice.Rules.AnyCheck"
          }
        ]
      }
    ]
  }
]
