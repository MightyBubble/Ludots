[
  {
    "_comment": "RTS unit cube marker renders all entities with VisualTransform",
    "id": "rts_unit_marker",
    "positionOffset": [
      0,
      0.5,
      0
    ],
    "bindings": [
      {
        "paramKey": "marker3d.color.r",
        "source": "entityColor",
        "sourceId": 0
      },
      {
        "paramKey": "marker3d.color.g",
        "source": "entityColor",
        "sourceId": 1
      },
      {
        "paramKey": "marker3d.color.b",
        "source": "entityColor",
        "sourceId": 2
      },
      {
        "paramKey": "marker3d.color.a",
        "source": "entityColor",
        "sourceId": 3
      }
    ],
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "*"
        },
        "command": {
          "kind": "CreatePresenter",
          "scopeSource": "EventPayloadA",
          "definitionId": "rts_unit_marker"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "*"
        },
        "command": {
          "kind": "DestroyPresenterScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "cube",
          "renderPath": "StaticMesh",
          "mobility": "Movable",
          "localScale": [
            1,
            1,
            1
          ]
        }
      }
    ]
  }
]
