[
  {
    "id": "Dialogue.Narrative.Briefing",
    "displayName": "Ashen Oath Briefing",
    "startNodeId": "briefing_intro",
    "nodes": [
      {
        "id": "briefing_intro",
        "speakerAlias": "elder",
        "speakerName": "Warden Mirelle",
        "cameraId": "Narrative.Intro.Elder",
        "text": "The Ember Shrine keeps count of every oath we break. Step close, {player}, and choose how you want to enter the trial.",
        "choices": [
          {
            "id": "briefing_lore",
            "text": "Tell me what the shrine remembers.",
            "actions": [
              { "kind": "AddVariable", "variableId": "lore", "valueKind": "Int", "intValue": 1 },
              { "kind": "AddVariable", "variableId": "trust", "valueKind": "Int", "intValue": 1 }
            ],
            "nextNodeId": "briefing_lore_reply"
          },
          {
            "id": "briefing_accept_now",
            "text": "I am ready. Open the path.",
            "nextNodeId": "briefing_accept"
          }
        ]
      },
      {
        "id": "briefing_lore_reply",
        "speakerAlias": "elder",
        "speakerName": "Warden Mirelle",
        "text": "Then listen well: the shrine marks every oath, every mercy, every lie. You already carry {lore} ember-memory with you.",
        "choices": [
          {
            "id": "briefing_accept_after_lore",
            "text": "Then let the shrine judge me.",
            "nextNodeId": "briefing_accept"
          }
        ]
      },
      {
        "id": "briefing_accept",
        "speakerAlias": "elder",
        "speakerName": "Warden Mirelle",
        "text": "Go to the shrine. Wake what sleeps beneath it, and return when you can name what should survive.",
        "onEnter": [
          { "kind": "AddVariable", "variableId": "trust", "valueKind": "Int", "intValue": 1 },
          { "kind": "AdvanceQuestStage", "questId": "Quest.Narrative.AshenOath" }
        ]
      }
    ]
  },
  {
    "id": "Dialogue.Narrative.Return",
    "displayName": "Ashen Oath Return",
    "startNodeId": "return_intro",
    "nodes": [
      {
        "id": "return_intro",
        "speakerAlias": "elder",
        "speakerName": "Warden Mirelle",
        "cameraId": "Narrative.Return.Close",
        "text": "You came back alive. Now answer plainly: what should this valley remember from the Ashen Beast?",
        "choices": [
          {
            "id": "return_duty",
            "text": "Seal the story. Let duty keep the valley safe.",
            "actions": [
              { "kind": "SetVariable", "variableId": "ending", "valueKind": "String", "stringValue": "Duty" },
              { "kind": "AddVariable", "variableId": "trust", "valueKind": "Int", "intValue": 1 },
              { "kind": "EmitSignal", "signalId": "showcase.reward_apply" },
              { "kind": "CompleteQuest", "questId": "Quest.Narrative.AshenOath" }
            ],
            "nextNodeId": "return_duty_outro"
          },
          {
            "id": "return_mercy",
            "text": "Remember it. Fear without memory will only grow back.",
            "conditions": [
              { "kind": "Variable", "variableId": "lore", "operator": "GreaterOrEqual", "intValue": 1 }
            ],
            "actions": [
              { "kind": "SetVariable", "variableId": "ending", "valueKind": "String", "stringValue": "Mercy" },
              { "kind": "AddVariable", "variableId": "trust", "valueKind": "Int", "intValue": 2 },
              { "kind": "EmitSignal", "signalId": "showcase.reward_apply" },
              { "kind": "CompleteQuest", "questId": "Quest.Narrative.AshenOath" }
            ],
            "nextNodeId": "return_mercy_outro"
          }
        ]
      },
      {
        "id": "return_duty_outro",
        "speakerAlias": "elder",
        "speakerName": "Warden Mirelle",
        "text": "Then the valley keeps its ward, and you leave it stronger than you found it. Ending: {ending}."
      },
      {
        "id": "return_mercy_outro",
        "speakerAlias": "elder",
        "speakerName": "Warden Mirelle",
        "text": "Then the valley keeps a memory instead of a scar. Ending: {ending}."
      }
    ]
  }
]
