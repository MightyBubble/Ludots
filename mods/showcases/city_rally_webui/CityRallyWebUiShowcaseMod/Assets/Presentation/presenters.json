[
  {
    "id": "city_rally.city.visual",
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "rts_city"
        },
        "command": {
          "kind": "CreatePresenter",
          "scopeSource": "EventPayloadA",
          "definitionId": "city_rally.city.visual"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "rts_city"
        },
        "command": {
          "kind": "DestroyPresenterScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "city_rally.city",
          "renderPath": "StaticMesh",
          "mobility": "Movable",
          "localScale": [
            1.5,
            1.5,
            1.5
          ]
        }
      },
      {
        "slot": "grounding",
        "kind": "Grounding",
        "activeByDefault": true,
        "grounding": {
          "mode": "SnapToGround",
          "offset": 0,
          "updatePolicy": "EveryFrame"
        }
      }
    ],
    "lifecycle": {
      "persistence": "Scoped"
    }
  },
