{
  "profiles": [
    {
      "id": "interaction.context.moba.battle",
      "inputContextId": "Core.Select",
      "commandIntentId": "intent.command.default",
      "bindings": [
        "Select.Begin",
        "Select.End"
      ],
      "triggers": [
        {
          "trigger": "graph.core.select_begin"
        },
        {
          "trigger": "graph.core.hover_tick"
        }
      ]
    },
    {
      "id": "interaction.context.core.selecting",
      "bindings": [
        "Select.End"
      ],
      "triggers": [
        {
          "trigger": "graph.core.select_commit"
        }
      ]
    },
    {
      "id": "interaction.context.minimap",
      "inputContextId": "Minimap.Device",
      "foreground": true,
      "pointerRouting": "ui",
      "bindings": [
        "Select.Begin",
        "Select.End",
        "Minimap.Zoom"
      ],
      "triggers": [
        { "trigger": "graph.minimap.press" },
        { "trigger": "graph.minimap.release" },
        { "trigger": "graph.minimap.track" },
        { "trigger": "graph.minimap.zoom" }
      ],
      "onActivated": [
        "graph.minimap.seed"
      ]
    }
  ]
}
