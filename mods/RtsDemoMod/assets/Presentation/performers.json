[
  {
    "_comment": "RTS actor ground ring: always-on entity-scoped overlay so units/buildings remain readable on the grid.",
    "id": "rts_actor_ring",
    "defaultColor": [
      0.22,
      0.54,
      0.96,
      0.18
    ],
    "defaultLifetime": -1,
    "maxVisibilityDistanceCm": 30000,
    "positionOffset": [
      0,
      0.05,
      0
    ],
    "visibility": {
      "inline": "OwnerCullVisible"
    },
    "bindings": [
      {
        "paramKey": "groundOverlay.innerRadius",
        "source": "constant",
        "constantValue": 0.84
      },
      {
        "paramKey": "groundOverlay.border.r",
        "source": "entityColor",
        "sourceId": 0
      },
      {
        "paramKey": "groundOverlay.border.g",
        "source": "entityColor",
        "sourceId": 1
      },
      {
        "paramKey": "groundOverlay.border.b",
        "source": "entityColor",
        "sourceId": 2
      },
      {
        "paramKey": "groundOverlay.border.a",
        "source": "constant",
        "constantValue": 1
      },
      {
        "paramKey": "groundOverlay.border.width",
        "source": "constant",
        "constantValue": 0.08
      }
    ],
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "*"
        },
        "command": {
          "kind": "CreatePerformer",
          "scopeSource": "EventPayloadA",
          "definitionId": "rts_actor_ring"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "*"
        },
        "command": {
          "kind": "DestroyPerformerScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "GroundOverlay",
          "assetId": "Ring",
          "renderPath": "None",
          "mobility": "Movable",
          "localScale": [
            1.5,
            1.5,
            1.5
          ]
        }
      }
    ]
  },
  {
    "_comment": "RTS actor marker: simple readable body proxy for RtsDemoMod when no showcase-only performer pack is loaded.",
    "id": "rts_actor_marker",
    "defaultColor": [
      0.92,
      0.96,
      1,
      0.98
    ],
    "defaultLifetime": -1,
    "maxVisibilityDistanceCm": 30000,
    "positionOffset": [
      0,
      0.55,
      0
    ],
    "visibility": {
      "inline": "OwnerCullVisible"
    },
    "bindings": [
      {
        "paramKey": "marker3d.scale.x",
        "source": "constant",
        "constantValue": 1.18
      },
      {
        "paramKey": "marker3d.scale.y",
        "source": "constant",
        "constantValue": 1.38
      },
      {
        "paramKey": "marker3d.scale.z",
        "source": "constant",
        "constantValue": 1.18
      },
      {
        "paramKey": "marker3d.color.r",
        "source": "entityColor",
        "sourceId": 0
      },
      {
        "paramKey": "marker3d.color.g",
        "source": "entityColor",
        "sourceId": 1
      },
      {
        "paramKey": "marker3d.color.b",
        "source": "entityColor",
        "sourceId": 2
      },
      {
        "paramKey": "marker3d.color.a",
        "source": "constant",
        "constantValue": 1
      }
    ],
    "rules": [
      {
        "event": {
          "kind": "EntitySpawned",
          "key": "*"
        },
        "command": {
          "kind": "CreatePerformer",
          "scopeSource": "EventPayloadA",
          "definitionId": "rts_actor_marker"
        },
        "condition": {
          "inline": "SourceHasVisualTransform"
        }
      },
      {
        "event": {
          "kind": "EntityDestroyed",
          "key": "*"
        },
        "command": {
          "kind": "DestroyPerformerScope",
          "scopeSource": "EventPayloadA"
        }
      }
    ],
    "behaviors": [
      {
        "slot": "body",
        "kind": "AssetBinding",
        "activeByDefault": true,
        "assetBinding": {
          "assetKind": "Mesh",
          "assetId": "cube",
          "renderPath": "StaticMesh",
          "mobility": "Movable",
          "localScale": [
            1.05,
            1.05,
            1.05
          ]
        }
      }
    ]
  }
]
