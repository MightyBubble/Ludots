  "contexts": [
    {
      "id": "CameraAcceptance.Controls",
      "name": "Camera Acceptance Controls",
      "priority": 110,
      "bindings": [
        { "actionId": "CameraAcceptanceModeRts", "path": "<Keyboard>/f1" },
        { "actionId": "CameraAcceptanceModeTps", "path": "<Keyboard>/f2" },
        { "actionId": "CameraAcceptanceModeFollowClose", "path": "<Keyboard>/f3" },
        { "actionId": "CameraAcceptanceModeFollowWide", "path": "<Keyboard>/f4" },
        {
          "actionId": "CameraAcceptanceLocalAvatarMove",
          "compositeType": "Vector2",
          "compositeParts": [
            { "path": "<Keyboard>/w" },
            { "path": "<Keyboard>/s" },
            { "path": "<Keyboard>/a" },
            { "path": "<Keyboard>/d" }
          ],
          "processors": [
            { "type": "Normalize" }
          ]
        },
        { "actionId": "Select", "path": "<Mouse>/LeftButton" },
        { "actionId": "Command", "path": "<Mouse>/RightButton" },
        { "actionId": "Cancel", "path": "<Keyboard>/escape" },
        { "actionId": "PointerPos", "path": "<Mouse>/Pos" },
        { "actionId": "CameraAcceptanceBlendCut", "path": "<Keyboard>/1" },
        { "actionId": "CameraAcceptanceBlendLinear", "path": "<Keyboard>/2" },
        { "actionId": "CameraAcceptanceBlendSmooth", "path": "<Keyboard>/3" },
        { "actionId": "CameraAcceptanceTpsAimHold", "path": "<Mouse>/RightButton" },
        {
          "actionId": "Look",
          "path": "<Mouse>/Delta",
          "processors": [
            {
              "type": "Invert",
              "parameters": [
                {
                  "name": "Y",
                  "value": 1
                }
              ]
            }
          ]
        },
        {
          "actionId": "Zoom",
          "path": "<Mouse>/ScrollY",
          "processors": [
            { "type": "Scale", "parameters": [{ "name": "Factor", "value": 0.1 }] }
          ]
        },
        { "actionId": "CameraAcceptanceStackReveal", "path": "<Keyboard>/r" },
        { "actionId": "CameraAcceptanceStackAlert", "path": "<Keyboard>/t" },
        { "actionId": "CameraAcceptanceStackClear", "path": "<Keyboard>/enter" },
        { "actionId": "CameraAcceptanceProjectionSpawnCountDecrease", "path": "<Keyboard>/q" },
        { "actionId": "CameraAcceptanceProjectionSpawnCountIncrease", "path": "<Keyboard>/e" },
        { "actionId": "CameraAcceptanceTogglePanel", "path": "<Keyboard>/f6" },
        { "actionId": "CameraAcceptanceToggleHud", "path": "<Keyboard>/f7" },
        { "actionId": "CameraAcceptanceToggleText", "path": "<Keyboard>/f8" },
        { "actionId": "CameraAcceptanceToggleHotpathBars", "path": "<Keyboard>/f9" },
        { "actionId": "CameraAcceptanceToggleHotpathHudText", "path": "<Keyboard>/f10" },
        { "actionId": "CameraAcceptanceToggleTerrain", "path": "<Keyboard>/f11" },
        { "actionId": "CameraAcceptanceToggleGuides", "path": "<Keyboard>/g" },
        { "actionId": "CameraAcceptanceTogglePrimitives", "path": "<Keyboard>/f12" },
        { "actionId": "CameraAcceptanceToggleHotpathCullCrowd", "path": "<Keyboard>/c" }
      ]
    }
