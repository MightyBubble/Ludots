<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SkiaNativeRid Condition="'$(SkiaNativeRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SkiaNativeRid>
    <SkiaNativeRid Condition="'$(SkiaNativeRid)' == '' and '$(OS)' == 'Windows_NT'">win-x64</SkiaNativeRid>
    <SkiaNativeRid Condition="'$(SkiaNativeRid)' == '' and '$([MSBuild]::IsOSPlatform(`Linux`))' == 'true'">linux-x64</SkiaNativeRid>
    <SkiaNativeRid Condition="'$(SkiaNativeRid)' == '' and '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true'">osx</SkiaNativeRid>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PresentationTests" />
    <InternalsVisibleTo Include="Ludots.Adapter.Raylib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\Ludots.Platform.Abstractions\Ludots.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\Libraries\Raylib-cs\Raylib-cs.csproj" />
    <ProjectReference Include="..\..\Libraries\SkiaSharp\SkiaSharp\SkiaSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Libraries\SkiaSharp\runtimes\**\*.*" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Platforms\Desktop\skinning_instanced.vs"><Link>skinning_instanced.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\skinning_instanced.fs"><Link>skinning_instanced.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\vfx_unlit_tint.vs"><Link>vfx_unlit_tint.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\vfx_unlit_tint.fs"><Link>vfx_unlit_tint.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\decal_project.vs"><Link>decal_project.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\decal_project.fs"><Link>decal_project.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\vegetation_cutout.vs"><Link>vegetation_cutout.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\vegetation_cutout.fs"><Link>vegetation_cutout.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\skybox.vs"><Link>skybox.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\skybox.fs"><Link>skybox.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\sky_daynight.vs"><Link>sky_daynight.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\sky_daynight.fs"><Link>sky_daynight.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\terrain.vs"><Link>terrain.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\terrain.fs"><Link>terrain.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\water.vs"><Link>water.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\water.fs"><Link>water.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\instancing.vs"><Link>instancing.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\instancing.fs"><Link>instancing.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\postprocess.fs"><Link>postprocess.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\model_lit.vs"><Link>model_lit.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\model_lit.fs"><Link>model_lit.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\shadow_depth.vs"><Link>shadow_depth.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\shadow_depth.fs"><Link>shadow_depth.fs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\shadow_depth_instanced.vs"><Link>shadow_depth_instanced.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\Platforms\Desktop\shadow_depth_skinning_instanced.vs"><Link>shadow_depth_skinning_instanced.vs</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="Resources\ambient_day_ramp.json"><Link>ambient_day_ramp.json</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="Resources\distance_fog.json"><Link>distance_fog.json</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

  <ItemGroup Condition="'$(SkiaNativeRid)' != ''">
    <None Include="..\..\Libraries\SkiaSharp\runtimes\$(SkiaNativeRid)\native\libSkiaSharp.dll"
          Link="libSkiaSharp.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\Libraries\SkiaSharp\runtimes\$(SkiaNativeRid)\native\libSkiaSharp.dll')" />
    <None Include="..\..\Libraries\SkiaSharp\runtimes\$(SkiaNativeRid)\native\libSkiaSharp.so"
          Link="libSkiaSharp.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\Libraries\SkiaSharp\runtimes\$(SkiaNativeRid)\native\libSkiaSharp.so')" />
    <None Include="..\..\Libraries\SkiaSharp\runtimes\$(SkiaNativeRid)\native\libSkiaSharp.dylib"
          Link="libSkiaSharp.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\Libraries\SkiaSharp\runtimes\$(SkiaNativeRid)\native\libSkiaSharp.dylib')" />
  </ItemGroup>

</Project>
