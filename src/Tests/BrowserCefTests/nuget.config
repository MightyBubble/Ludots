<?xml version="1.0" encoding="utf-8"?>
<!-- Cef 特例：Chromium natives（~230MB）不入库，此项目恢复时按需访问 nuget.org -->
<configuration>
  <packageSources>
    <clear />
    <add key="LudotsOffline" value="..\..\..\external\nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
