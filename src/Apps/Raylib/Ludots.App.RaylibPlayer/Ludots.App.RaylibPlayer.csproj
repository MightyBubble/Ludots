<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Shipping 构建（构建期裁剪）：dotnet publish -p:Shipping=true 出纯 ship 应用——无编辑器/gizmo/检视，无参直进场景。 -->
  <PropertyGroup Condition="'$(Shipping)' == 'true'">
    <DefineConstants>$(DefineConstants);LUDOTS_SHIPPING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Client\Ludots.Raylib.Render\Ludots.Raylib.Render.csproj" />
    <ProjectReference Include="..\..\..\Client\Ludots.Raylib.SceneKit\Ludots.Raylib.SceneKit.csproj" />
    <ProjectReference Include="..\..\..\Content\Ludots.Content.EngineGallery\Ludots.Content.EngineGallery.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="..\..\..\Platforms\Desktop\raylib.dll">
      <Link>raylib.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="..\..\..\Platforms\Desktop\libraylib.so">
      <Link>libraylib.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
