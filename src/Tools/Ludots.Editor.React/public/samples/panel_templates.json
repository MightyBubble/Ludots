{
  "schema": "ludots.ui.panel_template",
  "templates": [
    {
      "templateId": "panel.entity_info",
      "label": "实体信息卡",
      "blurb": "一张图多出口 → Panel 多引脚（像 Shader Graph）",
      "surfaceKind": "reactive",
      "graph": "graph.entity_info",
      "pins": [
        {
          "name": "hp",
          "label": "血量",
          "key": "panel.entity_info.hp",
          "mode": "realtime",
          "default": 0
        },
        {
          "name": "lastKill",
          "label": "上一次击杀",
          "key": "panel.entity_info.lastKill",
          "mode": "realtime",
          "default": 0
        },
        {
          "name": "curState",
          "label": "当前状态",
          "key": "panel.entity_info.curState",
          "mode": "snapshot",
          "default": 0
        }
      ]
    }
  ]
}
